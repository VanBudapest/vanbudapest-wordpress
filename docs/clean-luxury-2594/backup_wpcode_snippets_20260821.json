0 !important;\r\n        flex: 0 0 auto !important;\r\n        width: auto !important;\r\n        max-width: none !important;\r\n    }\r\n    .vb-eb-stripe > .vb-eb-dot {\r\n        display: inline-block !important;\r\n        width: 5px !important;\r\n        height: 5px !important;\r\n        min-width: 5px !important;\r\n        max-width: 5px !important;\r\n        padding: 0 !important;\r\n        margin: 0 !important;\r\n        flex: 0 0 5px !important;\r\n        border-radius: 50%;\r\n        background: #0A1F44;\r\n        opacity: 0.55;\r\n    }\r\n    .vb-eb-stripe strong { font-weight: 700; padding: 0 !important; margin: 0 !important; }\r\n    @media (max-width: 600px) {\r\n        .vb-eb-stripe {\r\n            font-size: 11px !important;\r\n            padding: 9px 12px !important;\r\n            letter-spacing: 0.04em;\r\n            column-gap: 8px;\r\n        }\r\n        .vb-eb-stripe > .vb-eb-dot {\r\n            width: 4px !important; height: 4px !important;\r\n            min-width: 4px !important; max-width: 4px !important;\r\n            flex: 0 0 4px !important;\r\n        }\r\n    }\r\n\r\n    \/* Savings pill (front face) \u2014 page 1649 pricing cards *\/\r\n    body.page-id-1649 .vb-eb-savings {\r\n        display: inline-block; margin-top: 10px; padding: 5px 12px;\r\n        background: rgba(200,181,96,0.12); border: 1px solid rgba(200,181,96,0.45);\r\n        color: #8a7433;\r\n        font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif;\r\n        font-size: 11.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;\r\n        border-radius: 3px;\r\n    }\r\n    body.page-id-1649 .vb-eb-savings::before {\r\n        content: \"\"; display: inline-block; width: 6px; height: 6px; border-radius: 50%;\r\n        background: #C8B560; margin-right: 7px; vertical-align: middle;\r\n    }\r\n\r\n    \/* Sticky CTA *\/\r\n    .vb-eb-sticky {\r\n        position: fixed; z-index: 9998;\r\n        font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif;\r\n        opacity: 0; pointer-events: none; transform: translateY(20px);\r\n        transition: opacity 0.35s ease, transform 0.35s ease;\r\n    }\r\n    .vb-eb-sticky.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }\r\n    @media (min-width: 769px) {\r\n        .vb-eb-sticky { right: 28px; bottom: 28px; max-width: 320px; }\r\n        .vb-eb-sticky a {\r\n            display: flex; align-items: center; gap: 14px; padding: 14px 22px;\r\n            background: linear-gradient(135deg, #0A1F44 0%, #152e5c 100%);\r\n            color: #fff; text-decoration: none; border-radius: 999px;\r\n            border: 1px solid rgba(200,181,96,0.6);\r\n            box-shadow: 0 12px 30px rgba(10,31,68,0.25), 0 0 0 3px rgba(10,31,68,0.04);\r\n            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;\r\n        }\r\n        .vb-eb-sticky a:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(10,31,68,0.32); border-color: #C8B560; }\r\n        .vb-eb-sticky .vb-eb-amount {\r\n            display: inline-flex; align-items: center; justify-content: center;\r\n            min-width: 50px; height: 50px; padding: 0 12px;\r\n            background: linear-gradient(135deg, #C8B560 0%, #a88f3f 100%);\r\n            color: #0A1F44; font-size: 17px; font-weight: 800; letter-spacing: 0.02em;\r\n            border-radius: 999px;\r\n        }\r\n        .vb-eb-sticky .vb-eb-copy { display: flex; flex-direction: column; line-height: 1.2; }\r\n        .vb-eb-sticky .vb-eb-headline { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #fff; }\r\n        .vb-eb-sticky .vb-eb-sub { font-size: 11px; font-weight: 500; letter-spacing: 0.05em; color: rgba(255,255,255,0.72); margin-top: 2px; }\r\n    }\r\n    @media (max-width: 768px) {\r\n        .vb-eb-sticky {\r\n            left: 0; right: 0; bottom: 0;\r\n            padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));\r\n            background: linear-gradient(135deg, #0A1F44 0%, #152e5c 100%);\r\n            border-top: 1px solid rgba(200,181,96,0.5);\r\n            box-shadow: 0 -8px 24px rgba(0,0,0,0.2);\r\n        }\r\n        .vb-eb-sticky a {\r\n            display: flex; align-items: center; justify-content: space-between; gap: 10px;\r\n            padding: 8px 14px; background: transparent; color: #fff; text-decoration: none; border: none;\r\n        }\r\n        .vb-eb-sticky .vb-eb-amount {\r\n            display: inline-flex; align-items: center; justify-content: center;\r\n            padding: 7px 11px;\r\n            background: linear-gradient(135deg, #C8B560 0%, #a88f3f 100%);\r\n            color: #0A1F44; font-size: 14px; font-weight: 800;\r\n            border-radius: 999px; white-space: nowrap;\r\n        }\r\n        .vb-eb-sticky .vb-eb-copy { flex: 1; text-align: left; line-height: 1.2; }\r\n        .vb-eb-sticky .vb-eb-headline { font-size: 13px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }\r\n        .vb-eb-sticky .vb-eb-sub { font-size: 10.5px; font-weight: 500; color: rgba(255,255,255,0.72); margin-top: 1px; }\r\n        .vb-eb-sticky .vb-eb-cta-arrow { font-size: 18px; color: #C8B560; padding-left: 4px; }\r\n    }\r\n    <\/style>\r\n\r\n    <script id=\"vb-f1-eb-ux-js\">\r\n    \/* VB_UX_V10_DOT_PADDING_FIX *\/\r\n    (function () {\r\n        'use strict';\r\n        var EB_DEADLINE = new Date('2027-02-28T23:59:59').getTime();\r\n        if (Date.now() > EB_DEADLINE) { return; }\r\n        var MID = String.fromCharCode(183);\r\n        var EUR = String.fromCharCode(8364);\r\n\r\n        function insertHeroStripe() {\r\n            if (document.querySelector('.vb-eb-stripe')) return;\r\n            var stripe = document.createElement('div');\r\n            \/* alignfull class ensures WordPress is-layout-constrained leaves it alone *\/\r\n            stripe.className = 'vb-eb-stripe alignfull';\r\n            stripe.innerHTML =\r\n                '<span class=\"vb-eb-seg\"><strong>Early Bird Pricing Active<\/strong><\/span>' +\r\n                '<span class=\"vb-eb-dot\" aria-hidden=\"true\"><\/span>' +\r\n                '<span class=\"vb-eb-seg\">Until 28 February 2027<\/span>' +\r\n                '<span class=\"vb-eb-dot\" aria-hidden=\"true\"><\/span>' +\r\n                '<span class=\"vb-eb-seg\">First-Come, First-Served<\/span>';\r\n\r\n            \/\/ Unified: stripe always goes ABOVE the hero as a standalone announcement bar\r\n            var hero = document.querySelector('.vb-f1-hero.vb-f1-fw');\r\n            if (hero && hero.parentNode) {\r\n                hero.parentNode.insertBefore(stripe, hero);\r\n                return;\r\n            }\r\n            var cover = document.querySelector('.entry-content .wp-block-cover, .entry-content > .wp-block-cover');\r\n            if (cover && cover.parentNode) { cover.parentNode.insertBefore(stripe, cover); return; }\r\n            var entry = document.querySelector('.entry-content');\r\n            if (entry) { entry.insertBefore(stripe, entry.firstChild); }\r\n        }\r\n\r\n        function decoratePricingCards() {\r\n            var cards = document.querySelectorAll('.vb-f1-pricing-grid .vb-f1-card');\r\n            if (!cards.length) return;\r\n            cards.forEach(function (card) {\r\n                card.querySelectorAll('.vb-eb-ribbon').forEach(function (r) { r.remove(); });\r\n                var front = card.querySelector('.vb-f1-card-front') || card;\r\n                if (!card.querySelector('.vb-eb-savings')) {\r\n                    var priceEl = front.querySelector('.vb-f1-pricing-details, .vb-f1-best-price, .vb-f1-card-availability');\r\n                    if (priceEl) {\r\n                        var savings = document.createElement('div');\r\n                        savings.className = 'vb-eb-savings';\r\n                        savings.textContent = 'Save up to ' + EUR + '250';\r\n                        priceEl.parentNode.insertBefore(savings, priceEl.nextSibling);\r\n                    }\r\n                }\r\n            });\r\n        }\r\n\r\n        function mountStickyCTA() {\r\n            if (document.querySelector('.vb-eb-sticky')) return;\r\n            var wrap = document.createElement('div');\r\n            wrap.className = 'vb-eb-sticky';\r\n            wrap.setAttribute('role', 'complementary');\r\n            wrap.setAttribute('aria-label', 'Early Bird offer');\r\n            wrap.innerHTML =\r\n                '<a href=\"#vb-f1-calculator\" data-vb-eb-cta>' +\r\n                    '<span class=\"vb-eb-amount\">&euro;100<\/span>' +\r\n                    '<span class=\"vb-eb-copy\">' +\r\n                        '<span class=\"vb-eb-headline\">Early Bird &mdash; Lock Your Rate<\/span>' +\r\n                        '<span class=\"vb-eb-sub\">Until 28 February &middot; Calculate instantly<\/span>' +\r\n                    '<\/span>' +\r\n                    '<span class=\"vb-eb-cta-arrow\" aria-hidden=\"true\">&rsaquo;<\/span>' +\r\n                '<\/a>';\r\n            document.body.appendChild(wrap);\r\n\r\n            var calc = document.getElementById('vb-f1-calculator');\r\n            var heroEl =\r\n                document.querySelector('.vb-f1-hero.vb-f1-fw') ||\r\n                document.querySelector('.entry-content .wp-block-cover');\r\n            var calcInView = false;\r\n\r\n            if (calc && 'IntersectionObserver' in window) {\r\n                var io = new IntersectionObserver(function (entries) {\r\n                    calcInView = entries[0].isIntersecting;\r\n                    update();\r\n                }, { threshold: 0.15 });\r\n                io.observe(calc);\r\n            }\r\n\r\n            function pastHero() {\r\n                if (calc) { return calc.getBoundingClientRect().bottom < 80; }\r\n                if (!heroEl) return window.scrollY > 400;\r\n                var r = heroEl.getBoundingClientRect();\r\n                return r.bottom < 80;\r\n            }\r\n\r\n            function update() {\r\n                if (pastHero() && !calcInView) { wrap.classList.add('is-visible'); }\r\n                else { wrap.classList.remove('is-visible'); }\r\n            }\r\n\r\n            window.addEventListener('scroll', update, { passive: true });\r\n            window.addEventListener('resize', update, { passive: true });\r\n            update();\r\n\r\n            wrap.querySelector('[data-vb-eb-cta]').addEventListener('click', function (e) {\r\n                if (!calc) return;\r\n                e.preventDefault();\r\n                var top = calc.getBoundingClientRect().top + window.scrollY - 70;\r\n                window.scrollTo({ top: top, behavior: 'smooth' });\r\n            });\r\n        }\r\n\r\n        function init() {\r\n            insertHeroStripe();\r\n            decoratePricingCards();\r\n            if (window.matchMedia('(min-width: 769px)').matches) { mountStickyCTA(); }\r\n        }\r\n\r\n        if (document.readyState === 'loading') {\r\n            document.addEventListener('DOMContentLoaded', init);\r\n        } else {\r\n            init();\r\n        }\r\n    })();\r\n    <\/script>\r\n    <?php\r\n}, 99);\r\n",
