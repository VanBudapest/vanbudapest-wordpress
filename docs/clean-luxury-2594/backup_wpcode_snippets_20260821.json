            "code": "\/* VB-MOBILFIX 2026-07-02: (1) 15 kobor '}' eltavolitva a fajl vegerol; (2) uj <=781px blokk - a logo a fix mobil-headeren BELUL ul (static, 36px), nem log a tartalomra (a korabbi <=480px min-height:70px !important legyozte a mobil-header 36px max-height-jat). Audit: 13-MOBIL-AUDIT-2026-07-02.md P1. Rollback: 15-BACKUP-MOBIL-FIX-2026-07-02\/wpcode-17496-logo-v1-3.css *\/\n:root{--vb-header-height:50px;--vb-logo-height:140px;--vb-logo-left:22px;--vb-logo-shadow:0 8px 30px rgba(0,0,0,0.25)}.wp-block-site-logo,.custom-logo-link,.site-logo,a.wp-block-site-logo{position:absolute !important;top:var(--vb-header-height) !important;left:var(--vb-logo-left) !important;z-index:100 !important;display:block !important;overflow:visible !important;flex-shrink:0 !important;}.wp-block-site-logo img,.custom-logo-link img,.custom-logo,.site-logo img,a.wp-block-site-logo img{height:var(--vb-logo-height) !important;min-height:var(--vb-logo-height) !important;max-height:var(--vb-logo-height) !important;width:auto !important;max-width:none !important;display:block !important;position:relative !important;top:0 !important;object-fit:contain !important;transition:all 0.3s ease !important;filter:drop-shadow(var(--vb-logo-shadow)) !important;}.wp-block-site-logo:hover img,.custom-logo-link:hover img{transform:scale(1.02) !important;filter:drop-shadow(0 12px 40px rgba(0,0,0,0.3)) !important;}.wp-block-site-logo.is-resized{width:auto !important;height:auto !important;}header.wp-block-template-part,.wp-site-blocks > header,.site-header,header#masthead,#masthead{overflow:visible !important;}header.wp-block-template-part > .wp-block-group,.wp-site-blocks > header > .wp-block-group,.site-header > .wp-block-group,header .wp-block-group{overflow:visible !important;}.wp-block-cover,.wp-block-cover-image,.hero-section,main .wp-block-cover:first-child,.entry-content > .wp-block-cover:first-child{position:relative !important;z-index:1 !important;}@media (max-width:1024px){:root{--vb-header-height:50px;--vb-logo-height:120px;--vb-logo-left:40px;}}@media (max-width:782px){:root{--vb-header-height:50px;--vb-logo-height:90px;--vb-logo-left:20px;}}@media (max-width:480px){:root{--vb-header-height:50px;--vb-logo-height:70px;--vb-logo-left:15px;}.wp-block-site-logo img,.custom-logo-link img{filter:drop-shadow(0 4px 15px rgba(0,0,0,0.2)) !important;}}\n@media (max-width:781px){.wp-block-site-logo,.custom-logo-link,.site-logo,a.wp-block-site-logo{position:static !important;top:auto !important;left:auto !important;}.wp-block-site-logo img,.custom-logo-link img,.custom-logo,.site-logo img,a.wp-block-site-logo img{height:36px !important;min-height:36px !important;max-height:36px !important;transform:none !important;}.wp-block-site-logo:hover img,.custom-logo-link:hover img{transform:none !important;}}",
