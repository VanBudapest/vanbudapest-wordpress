            "id": 21320,
            "title": "VB Blog Feed \u2014 Card Grid Enhancement",
            "code": "\/* ==========================================================\r\n   VanBudapest Blog Feed \u2014 Card Grid Enhancement\r\n   Target: Newspack Blocks Homepage Articles (4-column grid)\r\n   Page: \/budapest-airport-group-private-transportation\/\r\n   ========================================================== *\/\r\n\r\n\/* -- Blog Page Intro Section -- *\/\r\n.vb-blog-intro {\r\n  text-align: center;\r\n  max-width: 780px;\r\n  margin: 0 auto 48px auto;\r\n  padding: 0 16px;\r\n}\r\n\r\n.vb-blog-intro h1 {\r\n  font-family: 'Playfair Display', 'Georgia', serif;\r\n  font-size: 42px;\r\n  font-weight: 700;\r\n  color: #0A1F44;\r\n  margin-bottom: 8px;\r\n  letter-spacing: -0.5px;\r\n  line-height: 1.2;\r\n}\r\n\r\n.vb-blog-intro .vb-blog-intro__accent {\r\n  display: block;\r\n  width: 60px;\r\n  height: 3px;\r\n  background: #C8B560;\r\n  margin: 16px auto 20px auto;\r\n  border-radius: 2px;\r\n}\r\n\r\n.vb-blog-intro p {\r\n  font-family: 'Open Sans', Arial, sans-serif;\r\n  font-size: 17px;\r\n  line-height: 1.7;\r\n  color: #4A4A4A;\r\n  margin: 0;\r\n}\r\n\r\n\/* -- Card Image Aspect Ratio Fix (16:9) -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article .post-thumbnail,\r\n.wp-block-newspack-blocks-homepage-articles article .entry-wrapper .post-thumbnail {\r\n  position: relative;\r\n  width: 100%;\r\n  padding-top: 56.25%;\r\n  overflow: hidden;\r\n  border-radius: 6px 6px 0 0;\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article .post-thumbnail img,\r\n.wp-block-newspack-blocks-homepage-articles article .entry-wrapper .post-thumbnail img {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  object-position: center;\r\n  transition: transform 0.5s ease, filter 0.5s ease;\r\n}\r\n\r\n\/* -- Uniform Card Styling -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article {\r\n  background: #FFFFFF;\r\n  border: 1px solid rgba(10, 31, 68, 0.08);\r\n  border-radius: 6px;\r\n  box-shadow: 0 2px 8px rgba(10, 31, 68, 0.06);\r\n  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n\/* -- Card Content Area -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article .entry-wrapper {\r\n  padding: 20px 20px 16px 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex-grow: 1;\r\n}\r\n\r\n\/* -- Card Titles -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article .entry-title {\r\n  font-family: 'Montserrat', system-ui, sans-serif;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  color: #0A1F44;\r\n  margin-bottom: 8px;\r\n  transition: color 0.3s ease;\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article .entry-title a {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\n\/* -- Card Meta (date, category) -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article .entry-meta,\r\n.wp-block-newspack-blocks-homepage-articles article .cat-links {\r\n  font-family: 'Inter', system-ui, sans-serif;\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.8px;\r\n  color: #C8B560;\r\n  font-weight: 500;\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article .entry-meta .byline,\r\n.wp-block-newspack-blocks-homepage-articles article .entry-meta .posted-on {\r\n  color: #8A8A8A;\r\n}\r\n\r\n\/* -- Card Excerpt -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article .excerpt-text,\r\n.wp-block-newspack-blocks-homepage-articles article .entry-content {\r\n  font-family: 'Open Sans', Arial, sans-serif;\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: #555;\r\n  margin-top: auto;\r\n}\r\n\r\n\/* -- Hover Effects -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article:hover {\r\n  transform: translateY(-4px);\r\n  box-shadow: 0 8px 24px rgba(10, 31, 68, 0.12);\r\n  border-color: rgba(200, 181, 96, 0.3);\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article:hover .post-thumbnail img {\r\n  transform: scale(1.04);\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article:hover .entry-title {\r\n  color: #C8B560;\r\n}\r\n\r\n\/* -- Gold Top Border Accent on Hover -- *\/\r\n.wp-block-newspack-blocks-homepage-articles article::before {\r\n  content: '';\r\n  display: block;\r\n  height: 3px;\r\n  background: linear-gradient(90deg, #C8B560, #E5D9A8, #C8B560);\r\n  transform: scaleX(0);\r\n  transform-origin: left;\r\n  transition: transform 0.4s ease;\r\n}\r\n\r\n.wp-block-newspack-blocks-homepage-articles article:hover::before {\r\n  transform: scaleX(1);\r\n}\r\n\r\n\/* -- Responsive Grid -- *\/\r\n@media (max-width: 991px) {\r\n  .wp-block-newspack-blocks-homepage-articles {\r\n    display: grid !important;\r\n    grid-template-columns: 1fr 1fr !important;\r\n    gap: 24px !important;\r\n  }\r\n  .vb-blog-intro h1 {\r\n    font-size: 34px;\r\n  }\r\n}\r\n\r\n@media (max-width: 767px) {\r\n  .wp-block-newspack-blocks-homepage-articles {\r\n    grid-template-columns: 1fr !important;\r\n    gap: 20px !important;\r\n  }\r\n  .vb-blog-intro h1 {\r\n    font-size: 28px;\r\n  }\r\n  .vb-blog-intro p {\r\n    font-size: 15px;\r\n  }\r\n  .wp-block-newspack-blocks-homepage-articles article .entry-wrapper {\r\n    padding: 16px;\r\n  }\r\n}\r\n\r\n\/* -- Reduced Motion -- *\/\r\n@media (prefers-reduced-motion: reduce) {\r\n  .wp-block-newspack-blocks-homepage-articles article,\r\n  .wp-block-newspack-blocks-homepage-articles article .post-thumbnail img,\r\n  .wp-block-newspack-blocks-homepage-articles article::before {\r\n    transition: none !important;\r\n    transform: none !important;\r\n    animation: none !important;\r\n  }\r\n  .wp-block-newspack-blocks-homepage-articles article:hover {\r\n    transform: none;\r\n  }\r\n  .wp-block-newspack-blocks-homepage-articles article:hover .post-thumbnail img {\r\n    transform: none;\r\n  }\r\n}\r\n\r\n\/* -- Hide SEO-injected H1 on Blog Feed page (Page #7) -- *\/\r\n\/* The page already has a styled H2 page title from the theme; \r\n   the vbseo-injected-h1 creates a duplicate heading *\/\r\n.page-id-7 .vbseo-injected-h1 {\r\n  display: none !important;\r\n}",
