            "id": 23112,
            "title": "VanBudapest JS \u2014 Election 2026 (Post 23093)",
            "code": "\/* =====================================================\r\n   VANBUDAPEST.COM \u2014 FAQ + PROGRESS BAR + TOC JAVASCRIPT\r\n   CSAK Post ID 23093 \u2014 Hungary Election 2026 Guide\r\n   =====================================================\r\n   \r\n   HOVA: WPCode \u2192 New Snippet\r\n   CODE TYPE: JavaScript Snippet  \u2190 FONTOS, NEM CSS!\r\n   TITLE: VanBudapest JS \u2014 Election 2026 (Post 23093)\r\n   LOCATION: Site Wide Footer\r\n   ===================================================== *\/\r\n\r\n(function() {\r\n  'use strict';\r\n\r\n  \/* Csak a Post 23093-on fusson *\/\r\n  if (!document.body.classList.contains('postid-23093')) return;\r\n\r\n  \/* === Reading Progress Bar === *\/\r\n  var progressBar = document.getElementById('progressBar');\r\n  if (progressBar) {\r\n    window.addEventListener('scroll', function() {\r\n      var docHeight = document.documentElement.scrollHeight - window.innerHeight;\r\n      var scrolled = (window.scrollY \/ docHeight) * 100;\r\n      progressBar.style.width = Math.min(scrolled, 100) + '%';\r\n    }, { passive: true });\r\n  }\r\n\r\n  \/* === TOC Active State on Scroll === *\/\r\n  var tocLinks = document.querySelectorAll('.vb-toc__list a');\r\n  var sections = [];\r\n  tocLinks.forEach(function(link) {\r\n    var target = document.querySelector(link.getAttribute('href'));\r\n    if (target) sections.push({ el: target, link: link });\r\n  });\r\n\r\n  if (sections.length > 0) {\r\n    window.addEventListener('scroll', function() {\r\n      var scrollPos = window.scrollY + 120;\r\n      var active = sections[0].link;\r\n      sections.forEach(function(s) {\r\n        if (s.el.offsetTop <= scrollPos) active = s.link;\r\n      });\r\n      tocLinks.forEach(function(l) { l.classList.remove('active'); });\r\n      active.classList.add('active');\r\n    }, { passive: true });\r\n  }\r\n\r\n  \/* === Smooth Scroll for TOC Links === *\/\r\n  tocLinks.forEach(function(link) {\r\n    link.addEventListener('click', function(e) {\r\n      e.preventDefault();\r\n      var target = document.querySelector(this.getAttribute('href'));\r\n      if (target) {\r\n        window.scrollTo({\r\n          top: target.offsetTop - 70,\r\n          behavior: 'smooth'\r\n        });\r\n      }\r\n    });\r\n  });\r\n\r\n  \/* === FAQ Accordion === *\/\r\n  var faqItems = document.querySelectorAll('.vb-faq__item');\r\n  faqItems.forEach(function(item) {\r\n    var btn = item.querySelector('.vb-faq__question');\r\n    if (btn) {\r\n      btn.addEventListener('click', function() {\r\n        var isOpen = item.classList.contains('open');\r\n        faqItems.forEach(function(i) { i.classList.remove('open'); });\r\n        if (!isOpen) item.classList.add('open');\r\n        btn.setAttribute('aria-expanded', !isOpen);\r\n      });\r\n    }\r\n  });\r\n\r\n})();",
