            "title": "VB Frontend Fixes (P0+D-kor 2026-06-11): Office contact-only + Homepage hotfix + snippet-szkopok + perf",
            "code": "\/\/ ============================================================\r\n\/\/ 1) Office cim-blokk csere a CONTACT oldalon \u2014 P0 fix (BRAND-001)\r\n\/\/ ============================================================\r\nadd_action( 'wp_footer', function () {\r\n\tif ( ! is_page( 'contact-customer-reviews' ) ) { return; }\r\n\techo <<<'VBOFFICEJS'\r\n<script>\r\n(function() {\r\n  function replaceOffice() {\r\n    var grid = document.querySelector('.vb-office-grid');\r\n    if (!grid) return false;\r\n    var firstDiv = grid.children[0];\r\n    if (!firstDiv) return false;\r\n    firstDiv.innerHTML = '<p style=\"font-size:13px;color:#0A1F44;line-height:1.8;margin:0;\">' +\r\n      '<span style=\"font-family:Montserrat,system-ui,sans-serif;font-weight:600;color:#C8B560;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;\">Cser Roland Kft.<\/span>' +\r\n      ' \u2014 57 Ny\u00e1ry P\u00e1l Utca, 1205 Budapest, Hungary<br>' +\r\n      '<span style=\"font-family:Montserrat,system-ui,sans-serif;font-weight:600;color:#C8B560;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;\">VanBudapest.com<\/span>' +\r\n      ' \u2014 Ond vez\u00e9r \u00fatja 36, 1144 Budapest, Hungary<br>' +\r\n      '<span style=\"font-family:Montserrat,system-ui,sans-serif;font-weight:600;color:#C8B560;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;\">Kukl\u00e1n\u00e9 Sz\u0151ke \u00c9va e.v.<\/span>' +\r\n      ' \u2014 Szendr\u0151 utca 50, 1126 Budapest, Hungary' +\r\n      '<\/p>' +\r\n      '<p style=\"font-size:11px;color:#6b7280;line-height:1.7;margin:8px 0 0;\">' +\r\n      'Registered business activity: 821001 \u2013 Administrative and Business Support Services.<br>' +\r\n      'Licensed transportation services are provided through authorised chauffeurs, vehicles and transport partners, where applicable.' +\r\n      '<\/p>';\r\n    return true;\r\n  }\r\n  if (!replaceOffice()) {\r\n    var observer = new MutationObserver(function(mutations, obs) {\r\n      if (replaceOffice()) obs.disconnect();\r\n    });\r\n    observer.observe(document.body, {childList: true, subtree: true});\r\n    setTimeout(function() { replaceOffice(); observer.disconnect(); }, 3000);\r\n  }\r\n})();\r\n<\/script>\r\nVBOFFICEJS;\r\n}, 20 );\r\n\r\n\/\/ ============================================================\r\n\/\/ 2) Fooldal P0 hotfix \u2014 IMG-001 + IMG-002 + BRAND-005\r\n\/\/ ============================================================\r\nadd_filter( 'the_content', function ( $content ) {\r\n\tif ( ! is_front_page() ) { return $content; }\r\n\t$content = str_replace(\r\n\t\t'2026\/03\/MAJOR-STARLADDER-2025-VB-CS2-MVMDOME-MTKSPORTPARK-539.webp',\r\n\t\t'2026\/03\/MAJOR-STARLADDER-2025-VB-CS2-MVMDOME-MTKSPORTPARK-539-1024x683.webp',\r\n\t\t$content\r\n\t);\r\n\t$content = str_replace(\r\n\t\t'http:\/\/organicthemes.com\/demo\/chrono\/wp-content\/blogs.dir\/115\/files\/2023\/05\/',\r\n\t\t'https:\/\/vanbudapest.com\/wp-content\/uploads\/2026\/06\/',\r\n\t\t$content\r\n\t);\r\n\t$content = str_replace(\r\n\t\t'https:\/\/organicthemes.com\/demo\/chrono\/wp-content\/blogs.dir\/115\/files\/2023\/05\/',\r\n\t\t'https:\/\/vanbudapest.com\/wp-content\/uploads\/2026\/06\/',\r\n\t\t$content\r\n\t);\r\n\t$content = str_replace( 'height:undefinedpx', 'height:24px', $content );\r\n\t$content = str_replace( 'since 1990', 'since 1988', $content );\r\n\treturn $content;\r\n}, 8 );\r\n\r\n\/\/ ============================================================\r\n\/\/ 3) WPCode snippet-szkopolas (CONT-04 + D-kor CSS-02)\r\n\/\/ ============================================================\r\nadd_filter( 'wpcode_snippet_output', function ( $output ) {\r\n\t$args = func_get_args();\r\n\t$snippet = isset( $args[1] ) ? $args[1] : null;\r\n\tif ( ! is_object( $snippet ) ) { return $output; }\r\n\tif ( ! method_exists( $snippet, 'get_id' ) ) { return $output; }\r\n\t$sid = (int) $snippet->get_id();\r\n\tif ( 23335 === $sid || 23336 === $sid ) {\r\n\t\tif ( ! is_single( 23324 ) ) { return ''; }\r\n\t}\r\n\tif ( 23111 === $sid ) {\r\n\t\tif ( ! is_single( 23093 ) ) { return ''; }\r\n\t}\r\n\tif ( 21320 === $sid ) {\r\n\t\tif ( ! is_page( 7 ) ) { return ''; }\r\n\t}\r\n\tif ( 19561 === $sid ) {\r\n\t\tif ( ! is_page( array( 1649, 3725 ) ) ) { return ''; }\r\n\t}\r\n\treturn $output;\r\n}, 10, 2 );\r\n\r\n\/\/ ============================================================\r\n\/\/ 4) Preconnect + konszolidalt Google Fonts link (wp_head, prio 1)\r\n\/\/ J-kor: URL BOVITVE (F1 @importok + Playfair italic fedese) \u2014 Tomi jovahagyta.\r\n\/\/ ============================================================\r\nadd_action( 'wp_head', 'vb_ekor_preconnect_and_fonts', 1 );\r\nfunction vb_ekor_preconnect_and_fonts() {\r\n\tif ( is_admin() ) {\r\n\t\treturn;\r\n\t}\r\n\techo '<link rel=\"preconnect\" href=\"https:\/\/spcdn.shortpixel.ai\">' . \"\\n\";\r\n\techo '<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">' . \"\\n\";\r\n\techo '<link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>' . \"\\n\";\r\n\techo '<link rel=\"preconnect\" href=\"https:\/\/videos.files.wordpress.com\">' . \"\\n\";\r\n\techo '<link rel=\"stylesheet\" href=\"https:\/\/fonts.googleapis.com\/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=DM+Sans:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600;700;800&amp;family=Montserrat:wght@400;500;600;700;800&amp;family=Open+Sans:wght@400;500;600&amp;family=Playfair+Display:ital,wght@0,400;0,700;1,400&amp;family=Poppins:wght@500;600;700&amp;display=swap\">' . \"\\n\";\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 5) Hero cover video: preload=\"metadata\" + poster (LOAD-PERF-3)\r\n\/\/ ============================================================\r\nadd_filter( 'render_block_core\/cover', 'vb_ekor_cover_video_poster', 10, 2 );\r\nfunction vb_ekor_cover_video_poster( $block_content, $block ) {\r\n\tif ( false === strpos( $block_content, 'RzMq2sfz' ) ) {\r\n\t\treturn $block_content;\r\n\t}\r\n\tif ( false !== strpos( $block_content, 'poster=' ) ) {\r\n\t\treturn $block_content;\r\n\t}\r\n\t$vb_poster = 'https:\/\/videos.files.wordpress.com\/RzMq2sfz\/vanbudapest-1988-vip_mp4_hd.original.jpg';\r\n\t$block_content = str_replace(\r\n\t\t'<video class=\"wp-block-cover__video-background',\r\n\t\t'<video preload=\"metadata\" poster=\"' . $vb_poster . '\" class=\"wp-block-cover__video-background',\r\n\t\t$block_content\r\n\t);\r\n\treturn $block_content;\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 6a) Logo: fetchpriority=\"high\" eltavolitasa\r\n\/\/ ============================================================\r\nadd_filter( 'get_custom_logo', 'vb_ekor_logo_no_fetchpriority', 10, 1 );\r\nfunction vb_ekor_logo_no_fetchpriority( $html ) {\r\n\treturn str_replace( ' fetchpriority=\"high\"', '', $html );\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 6b) Fooldalon a hero poszter preload-ja (wp_head, prio 2)\r\n\/\/ ============================================================\r\nadd_action( 'wp_head', 'vb_ekor_front_poster_preload', 2 );\r\nfunction vb_ekor_front_poster_preload() {\r\n\tif ( ! is_front_page() ) {\r\n\t\treturn;\r\n\t}\r\n\techo '<link rel=\"preload\" as=\"image\" href=\"https:\/\/videos.files.wordpress.com\/RzMq2sfz\/vanbudapest-1988-vip_mp4_hd.original.jpg\" fetchpriority=\"high\">' . \"\\n\";\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 7) Dupla Font Awesome dequeue (dashicons: audit utan, kulon korben)\r\n\/\/ ============================================================\r\nadd_action( 'wp_enqueue_scripts', 'vb_ekor_dequeue_unused_styles', 100 );\r\nfunction vb_ekor_dequeue_unused_styles() {\r\n\twp_dequeue_style( 'organic-blocks-font-awesome' );\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 8) vb-confirmation-fix CSS \u2014 CSAK a contact oldalon (ID 10546)\r\n\/\/ ============================================================\r\nadd_action( 'wp_head', 'vb_confirmation_fix_css', 20 );\r\nfunction vb_confirmation_fix_css() {\r\n\tif ( ! is_page( 10546 ) ) {\r\n\t\treturn;\r\n\t}\r\n\techo <<<'VBCONFCSS'\r\n<style id=\"vb-confirmation-fix\">\r\n\/* FIX: Force confirmation card children visible \u2014 override animation opacity:0 *\/\r\n#confirmation.vb-form-card.active,\r\n#confirmation.vb-form-card.active *{opacity:1!important;visibility:visible!important;transform:none!important;animation:none!important}\r\n#confirmation.vb-form-card.active .vb-confirmation{opacity:1!important}\r\n#confirmation.vb-form-card.active .vb-confirm-check,\r\n#confirmation.vb-form-card.active .vb-confirmation-title,\r\n#confirmation.vb-form-card.active .vb-confirmation-subtitle,\r\n#confirmation.vb-form-card.active .vb-confirmation-text,\r\n#confirmation.vb-form-card.active .vb-next-steps,\r\n#confirmation.vb-form-card.active .vb-countdown-row,\r\n#confirmation.vb-form-card.active .vb-redirect-section{opacity:1!important;visibility:visible!important;transform:none!important;animation:none!important}\r\n.vb-review-overlay:not(.open){display:none!important;pointer-events:none!important}\r\n<\/style>\r\nVBCONFCSS;\r\n}\r\n\r\n\/\/ ============================================================\r\n\/\/ 9) Site Kit Tag Manager modul kikapcsolasa (PERF-8)\r\n\/\/ ============================================================\r\nadd_filter( 'option_googlesitekit_active_modules', function ( $m ) {\r\n\tif ( ! is_array( $m ) ) {\r\n\t\treturn $m;\r\n\t}\r\n\t$out = array();\r\n\tforeach ( $m as $x ) {\r\n\t\tif ( 'tagmanager' !== $x ) {\r\n\t\t\t$out[] = $x;\r\n\t\t}\r\n\t}\r\n\treturn $out;\r\n} );",
