            "title": "VanBudapest CSS \u2014 UCL Final 2026 (Post 23324)",
            "code": "\/* ============= UCL FINAL 2026 \u00b7 BUDAPEST \u00b7 DESIGN TOKENS ============= *\/\n.vb-ucl{\n  --vb-navy:#0A1F44;--vb-navy-deep:#050f24;--vb-gold:#C8B560;--vb-gold-bright:#e8d488;\n  --vb-ivory:#F4EFE6;--vb-ink:#0b1333;--ucl-night:#04081c;--ucl-royal:#0a1a6b;\n  --ucl-cyan:#2dd8ff;--ucl-star:#cfe6ff;\n  --psg:#004170;--psg-red:#DA291C;--bayern:#DC052D;--bayern-blue:#0066B2;\n  --atleti-red:#CE3524;--atleti-blue:#272E61;--arsenal:#EF0107;--arsenal-navy:#063672;\n  --radius-lg:20px;--radius-md:14px;--ease:cubic-bezier(.2,.7,.2,1);\n  --font-display:\"Playfair Display\", Georgia, serif;\n  --font-sans:\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  color:var(--vb-ivory);font-family:var(--font-sans);line-height:1.6;\n}\n.vb-ucl .vb-fw{position:relative;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;max-width:none;}\n\n\/* HERO *\/\n.vb-ucl .ucl-hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;background:#04081c;display:flex;align-items:center;justify-content:center;isolation:isolate;}\n.vb-ucl .ucl-hero__bg{position:absolute;inset:-8%;background:radial-gradient(1200px 700px at 50% 120%, rgba(10,26,107,.55), transparent 60%),radial-gradient(900px 600px at 20% 20%, rgba(45,216,255,.18), transparent 55%),url('https:\/\/vanbudapest.com\/wp-content\/uploads\/2026\/04\/puskas-arena-group-transfers-stadium-events-budapest-10.webp') center\/cover no-repeat,#04081c;filter:saturate(1.1) contrast(1.05);transform:scale(1.08);animation:ucl-kenburns 22s ease-in-out infinite alternate;z-index:0;}\n.vb-ucl .ucl-hero__veil{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg, rgba(4,8,28,.35) 0%, rgba(4,8,28,.55) 45%, rgba(4,8,28,.92) 100%),radial-gradient(ellipse at center, transparent 30%, rgba(4,8,28,.6) 80%);}\n.vb-ucl .ucl-canvas{position:absolute;inset:0;z-index:2;pointer-events:none;opacity:.85;}\n.vb-ucl .ucl-hero__inner{position:relative;z-index:3;max-width:1200px;padding:80px 24px;text-align:center;width:100%;}\n.vb-ucl .ucl-eyebrow{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border-radius:999px;background:rgba(200,181,96,.1);border:1px solid rgba(200,181,96,.35);color:var(--vb-gold-bright);font-size:12px;letter-spacing:.25em;text-transform:uppercase;font-weight:600;margin-bottom:28px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);}\n.vb-ucl .ucl-eyebrow::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--ucl-cyan);box-shadow:0 0 12px var(--ucl-cyan);animation:ucl-pulse 2s ease-in-out infinite;}\n.vb-ucl .ucl-hero h1{font-family:var(--font-display);font-weight:800;font-size:clamp(40px, 7vw, 88px);line-height:1.02;margin:0 0 18px;letter-spacing:-.02em;color:#fff;text-shadow:0 4px 40px rgba(10,26,107,.8);}\n.vb-ucl .ucl-hero h1 .shine{background:linear-gradient(100deg, var(--vb-gold) 0%, #fff7d9 35%, var(--vb-gold-bright) 55%, var(--vb-gold) 75%, var(--vb-gold-bright) 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:ucl-shine 5s linear infinite;display:inline-block;}\n.vb-ucl .ucl-hero__sub{color:rgba(244,239,230,.85);font-size:clamp(16px,1.6vw,20px);max-width:780px;margin:0 auto 40px;line-height:1.55;}\n\n\/* META *\/\n.vb-ucl .ucl-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;max-width:900px;margin:0 auto 44px;}\n.vb-ucl .ucl-meta__item{padding:18px 14px;border-radius:var(--radius-md);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);text-align:center;transition:transform .4s var(--ease), border-color .4s;}\n.vb-ucl .ucl-meta__item:hover{transform:translateY(-4px);border-color:rgba(200,181,96,.5)}\n.vb-ucl .ucl-meta__k{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--vb-gold-bright);font-weight:600;}\n.vb-ucl .ucl-meta__v{font-family:var(--font-display);font-size:22px;font-weight:700;color:#fff;margin-top:6px;}\n\n\/* COUNTDOWN *\/\n.vb-ucl .ucl-countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:620px;margin:0 auto 40px;}\n.vb-ucl .ucl-cd{padding:20px 10px;border-radius:var(--radius-md);background:linear-gradient(180deg, rgba(200,181,96,.12), rgba(10,26,107,.4));border:1px solid rgba(200,181,96,.3);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);position:relative;overflow:hidden;}\n.vb-ucl .ucl-cd::before{content:\"\";position:absolute;inset:0;background:linear-gradient(100deg, transparent 30%, rgba(255,255,255,.08) 50%, transparent 70%);transform:translateX(-100%);animation:ucl-shine-slide 6s ease-in-out infinite;}\n.vb-ucl .ucl-cd__n{font-family:var(--font-display);font-size:clamp(32px,5vw,52px);font-weight:800;color:#fff;line-height:1;display:block;font-variant-numeric:tabular-nums;}\n.vb-ucl .ucl-cd__l{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--vb-gold-bright);margin-top:8px;display:block;font-weight:600;}\n\n\/* BUTTONS *\/\n.vb-ucl .ucl-cta-row{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}\n.vb-ucl .ucl-btn{display:inline-flex;align-items:center;gap:10px;padding:16px 30px;border-radius:999px;font-weight:700;font-size:15px;letter-spacing:.04em;text-decoration:none;transition:all .35s var(--ease);white-space:nowrap;border:1px solid transparent;cursor:pointer;}\n.vb-ucl .ucl-btn--gold{background:linear-gradient(135deg,var(--vb-gold) 0%, var(--vb-gold-bright) 100%);color:var(--vb-navy);box-shadow:0 12px 40px rgba(200,181,96,.35);}\n.vb-ucl .ucl-btn--gold:hover{transform:translateY(-3px);box-shadow:0 18px 48px rgba(200,181,96,.5)}\n.vb-ucl .ucl-btn--ghost{background:rgba(255,255,255,.06);color:#fff;border-color:rgba(255,255,255,.25);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);}\n.vb-ucl .ucl-btn--ghost:hover{background:rgba(255,255,255,.12);border-color:var(--vb-gold)}\n.vb-ucl .ucl-btn--wa{background:#25D366;color:#fff}\n.vb-ucl .ucl-btn--wa:hover{transform:translateY(-3px);background:#1fb558}\n\n.vb-ucl .ucl-scroll{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);z-index:4;color:rgba(255,255,255,.65);font-size:11px;letter-spacing:.3em;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:8px;}\n.vb-ucl .ucl-scroll__line{width:1px;height:40px;background:linear-gradient(180deg,var(--vb-gold),transparent);animation:ucl-scroll-line 2.2s ease-in-out infinite;}\n\n\/* TICKER *\/\n.vb-ucl .ucl-ticker{background:linear-gradient(90deg,var(--vb-navy) 0%, var(--ucl-royal) 50%, var(--vb-navy) 100%);border-top:1px solid rgba(200,181,96,.3);border-bottom:1px solid rgba(200,181,96,.3);overflow:hidden;padding:14px 0;}\n.vb-ucl .ucl-ticker__track{display:flex;gap:60px;white-space:nowrap;animation:ucl-ticker 40s linear infinite;width:max-content;}\n.vb-ucl .ucl-ticker__item{display:inline-flex;align-items:center;gap:14px;color:var(--vb-gold-bright);font-weight:600;font-size:13px;letter-spacing:.15em;text-transform:uppercase;}\n.vb-ucl .ucl-ticker__dot{width:6px;height:6px;border-radius:50%;background:var(--ucl-cyan);box-shadow:0 0 10px var(--ucl-cyan);}\n\n\/* BRACKET *\/\n.vb-ucl .ucl-bracket{position:relative;padding:110px 24px 90px;background:radial-gradient(1200px 800px at 50% 30%, rgba(10,26,107,.6), transparent 60%),linear-gradient(180deg, #04081c 0%, #050f24 100%);overflow:hidden;}\n.vb-ucl .ucl-bracket::before{content:\"\";position:absolute;inset:0;background-image:radial-gradient(1px 1px at 10% 20%, rgba(207,230,255,.6), transparent),radial-gradient(1px 1px at 80% 60%, rgba(207,230,255,.5), transparent),radial-gradient(1px 1px at 40% 80%, rgba(207,230,255,.4), transparent),radial-gradient(1px 1px at 65% 25%, rgba(207,230,255,.5), transparent),radial-gradient(1px 1px at 25% 55%, rgba(207,230,255,.4), transparent);opacity:.7;pointer-events:none;}\n.vb-ucl .ucl-section-head{text-align:center;max-width:820px;margin:0 auto 60px;position:relative;}\n.vb-ucl .ucl-section-head__tag{display:inline-block;padding:6px 14px;border-radius:999px;background:rgba(200,181,96,.12);color:var(--vb-gold-bright);font-size:11px;letter-spacing:.25em;text-transform:uppercase;font-weight:700;margin-bottom:18px;border:1px solid rgba(200,181,96,.3);}\n.vb-ucl .ucl-section-head h2{font-family:var(--font-display);font-size:clamp(32px,4.5vw,52px);font-weight:800;color:#fff;margin:0 0 14px;line-height:1.1;letter-spacing:-.01em;}\n.vb-ucl .ucl-section-head p{color:rgba(244,239,230,.75);font-size:17px;margin:0;line-height:1.55;}\n\n.vb-ucl .ucl-bracket__grid{position:relative;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;gap:30px;align-items:center;}\n.vb-ucl .ucl-bracket__col{display:flex;flex-direction:column;gap:24px}\n.vb-ucl .ucl-bracket__pair{display:flex;flex-direction:column;gap:8px;position:relative;}\n.vb-ucl .ucl-bracket__card{display:flex;align-items:center;gap:16px;padding:18px 22px;border-radius:var(--radius-md);background:linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:all .4s var(--ease);cursor:default;}\n.vb-ucl .ucl-bracket__card:hover{border-color:var(--vb-gold);transform:translateX(6px);background:linear-gradient(135deg, rgba(200,181,96,.15), rgba(255,255,255,.04));}\n.vb-ucl .ucl-bracket__col--right .ucl-bracket__card:hover{transform:translateX(-6px)}\n.vb-ucl .ucl-bracket__badge{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:18px;color:#fff;flex-shrink:0;box-shadow:0 4px 16px rgba(0,0,0,.3);}\n.vb-ucl .ucl-bracket__badge--psg{background:linear-gradient(135deg,var(--psg),#002846);}\n.vb-ucl .ucl-bracket__badge--bayern{background:linear-gradient(135deg,var(--bayern),#9a0020);}\n.vb-ucl .ucl-bracket__badge--atleti{background:linear-gradient(135deg,var(--atleti-red),var(--atleti-blue));}\n.vb-ucl .ucl-bracket__badge--arsenal{background:linear-gradient(135deg,var(--arsenal),var(--arsenal-navy));}\n.vb-ucl .ucl-bracket__team{flex:1;}\n.vb-ucl .ucl-bracket__team strong{display:block;font-size:18px;font-weight:700;color:#fff;margin-bottom:2px;}\n.vb-ucl .ucl-bracket__team span{font-size:12px;color:rgba(244,239,230,.6);letter-spacing:.05em;}\n.vb-ucl .ucl-bracket__vs{text-align:center;color:var(--vb-gold-bright);font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:.3em;text-transform:uppercase;padding:4px 0;}\n\n.vb-ucl .ucl-bracket__center{display:flex;flex-direction:column;align-items:center;gap:14px;position:relative;}\n.vb-ucl .ucl-trophy{width:140px;height:140px;border-radius:50%;background:radial-gradient(circle at 30% 30%, var(--vb-gold-bright), var(--vb-gold) 50%, #8a7a3e 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 6px rgba(200,181,96,.15),0 0 0 14px rgba(200,181,96,.08),0 20px 60px rgba(200,181,96,.45),inset 0 -10px 20px rgba(0,0,0,.3);position:relative;animation:ucl-trophy-glow 3.5s ease-in-out infinite;}\n.vb-ucl .ucl-trophy svg{width:70px;height:70px;filter:drop-shadow(0 3px 6px rgba(0,0,0,.4));}\n.vb-ucl .ucl-trophy__date{font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--vb-gold-bright);letter-spacing:.1em;text-align:center;text-transform:uppercase;}\n.vb-ucl .ucl-trophy__venue{font-size:13px;color:rgba(244,239,230,.7);text-align:center;}\n\n\/* TEAMS 3D *\/\n.vb-ucl .ucl-teams{padding:100px 24px;background:linear-gradient(180deg, #050f24 0%, #0a1a3a 100%);position:relative;overflow:hidden;}\n.vb-ucl .ucl-teams__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px;}\n.vb-ucl .ucl-team{position:relative;border-radius:var(--radius-lg);padding:30px 24px 28px;overflow:hidden;transform-style:preserve-3d;transition:transform .4s var(--ease), box-shadow .4s;min-height:280px;display:flex;flex-direction:column;justify-content:space-between;cursor:default;border:1px solid rgba(255,255,255,.08);will-change:transform;}\n.vb-ucl .ucl-team--psg{background:linear-gradient(145deg,var(--psg) 0%, #002238 60%, var(--psg-red) 130%);}\n.vb-ucl .ucl-team--bayern{background:linear-gradient(145deg,var(--bayern) 0%, #7a0019 60%, #fff 200%);}\n.vb-ucl .ucl-team--atleti{background:linear-gradient(145deg,var(--atleti-red) 0%, #8b1e14 60%, var(--atleti-blue) 130%);}\n.vb-ucl .ucl-team--arsenal{background:linear-gradient(145deg,var(--arsenal) 0%, #9a0005 60%, var(--arsenal-navy) 130%);}\n.vb-ucl .ucl-team::before{content:\"\";position:absolute;inset:0;background:radial-gradient(600px circle at var(--mx,50%) var(--my,30%), rgba(255,255,255,.18), transparent 40%);pointer-events:none;opacity:0;transition:opacity .4s;transform:translateZ(40px);}\n.vb-ucl .ucl-team:hover::before{opacity:1}\n.vb-ucl .ucl-team:hover{box-shadow:0 30px 80px rgba(0,0,0,.5)}\n.vb-ucl .ucl-team__top{display:flex;justify-content:space-between;align-items:flex-start;transform:translateZ(30px);}\n.vb-ucl .ucl-team__tag{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:rgba(255,255,255,.85);font-weight:700;padding:5px 10px;border-radius:999px;background:rgba(0,0,0,.25);}\n.vb-ucl .ucl-team__num{font-family:var(--font-display);font-weight:800;color:rgba(255,255,255,.18);font-size:44px;line-height:1;}\n.vb-ucl .ucl-team__name{font-family:var(--font-display);font-weight:800;color:#fff;font-size:32px;line-height:1.05;margin:20px 0 8px;transform:translateZ(40px);text-shadow:0 4px 20px rgba(0,0,0,.3);}\n.vb-ucl .ucl-team__city{color:rgba(255,255,255,.8);font-size:14px;letter-spacing:.15em;text-transform:uppercase;font-weight:600;transform:translateZ(35px);}\n.vb-ucl .ucl-team__bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.18);transform:translateZ(25px);}\n.vb-ucl .ucl-team__fact{font-size:12px;color:rgba(255,255,255,.75);max-width:65%;line-height:1.4;}\n.vb-ucl .ucl-team__arrow{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;color:#fff;transition:all .3s;}\n.vb-ucl .ucl-team:hover .ucl-team__arrow{background:rgba(255,255,255,.3);transform:rotate(-45deg)}\n\n\/* STADIUM *\/\n.vb-ucl .ucl-stadium{position:relative;overflow:hidden;padding:140px 24px;background:#04081c;}\n.vb-ucl .ucl-stadium__bg{position:absolute;inset:-15% 0;background:url('https:\/\/vanbudapest.com\/wp-content\/uploads\/2026\/04\/puskas-arena-group-transfers-stadium-events-budapest-10.webp') center\/cover no-repeat;z-index:0;will-change:transform;filter:brightness(.65) saturate(1.1);}\n.vb-ucl .ucl-stadium__veil{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg, rgba(4,8,28,.7) 0%, rgba(10,26,107,.55) 50%, rgba(4,8,28,.9) 100%);}\n.vb-ucl .ucl-stadium__inner{position:relative;z-index:2;max-width:1200px;margin:0 auto;text-align:center;}\n.vb-ucl .ucl-stadium h2{font-family:var(--font-display);font-size:clamp(34px,5vw,58px);color:#fff;font-weight:800;margin:0 0 20px;line-height:1.05;letter-spacing:-.01em;}\n.vb-ucl .ucl-stadium__lead{color:rgba(244,239,230,.85);font-size:17px;max-width:700px;margin:0 auto 60px;line-height:1.65;}\n.vb-ucl .ucl-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:22px;max-width:1000px;margin:0 auto;}\n.vb-ucl .ucl-stat{padding:34px 20px;border-radius:var(--radius-lg);background:rgba(255,255,255,.06);border:1px solid rgba(200,181,96,.25);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);position:relative;overflow:hidden;transition:all .5s var(--ease);}\n.vb-ucl .ucl-stat:hover{transform:translateY(-6px);border-color:var(--vb-gold);background:rgba(255,255,255,.1);}\n.vb-ucl .ucl-stat__num{font-family:var(--font-display);font-weight:800;font-size:clamp(40px,5vw,64px);line-height:1;background:linear-gradient(135deg,var(--vb-gold),#fff5c8 50%,var(--vb-gold-bright));-webkit-background-clip:text;background-clip:text;color:transparent;display:block;font-variant-numeric:tabular-nums;}\n.vb-ucl .ucl-stat__suf{font-size:.5em;color:var(--vb-gold-bright);}\n.vb-ucl .ucl-stat__l{color:rgba(244,239,230,.8);font-size:13px;letter-spacing:.15em;text-transform:uppercase;font-weight:600;margin-top:14px;display:block;}\n\n\/* TIMELINE *\/\n.vb-ucl .ucl-timeline{padding:110px 24px;background:linear-gradient(180deg, #050f24 0%, #091535 100%);position:relative;}\n.vb-ucl .ucl-tl{max-width:900px;margin:0 auto;position:relative;}\n.vb-ucl .ucl-tl::before{content:\"\";position:absolute;left:28px;top:20px;bottom:20px;width:2px;background:linear-gradient(180deg, transparent, var(--vb-gold) 10%, var(--vb-gold) 90%, transparent);}\n.vb-ucl .ucl-tl__item{position:relative;padding:18px 0 40px 80px;opacity:0;transform:translateX(-30px);transition:opacity .8s var(--ease), transform .8s var(--ease);}\n.vb-ucl .ucl-tl__item.is-in{opacity:1;transform:translateX(0);}\n.vb-ucl .ucl-tl__dot{position:absolute;left:13px;top:24px;width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--vb-gold),var(--vb-gold-bright));display:flex;align-items:center;justify-content:center;color:var(--vb-navy);font-weight:800;font-size:14px;box-shadow:0 0 0 6px rgba(10,26,107,1), 0 0 0 8px rgba(200,181,96,.25), 0 8px 24px rgba(200,181,96,.35);}\n.vb-ucl .ucl-tl__time{font-family:var(--font-display);font-size:26px;font-weight:700;color:var(--vb-gold-bright);margin-bottom:6px;display:block;letter-spacing:.02em;}\n.vb-ucl .ucl-tl__title{font-size:19px;color:#fff;margin:0 0 8px;font-weight:700;}\n.vb-ucl .ucl-tl__desc{color:rgba(244,239,230,.78);font-size:15px;margin:0;line-height:1.6;}\n\n\/* FLEET *\/\n.vb-ucl .ucl-fleet{padding:100px 0 90px;background:linear-gradient(180deg, #091535 0%, #04081c 100%);}\n.vb-ucl .ucl-fleet__head{max-width:1200px;margin:0 auto 50px;padding:0 24px;text-align:center;}\n.vb-ucl .ucl-fleet__scroll{display:flex;gap:22px;overflow-x:auto;overflow-y:hidden;padding:10px 24px 40px;scroll-snap-type:x mandatory;scroll-padding-left:24px;scrollbar-width:thin;scrollbar-color:var(--vb-gold) rgba(255,255,255,.05);-webkit-overflow-scrolling:touch;}\n.vb-ucl .ucl-fleet__scroll::-webkit-scrollbar{height:8px;}\n.vb-ucl .ucl-fleet__scroll::-webkit-scrollbar-track{background:rgba(255,255,255,.05);border-radius:4px;}\n.vb-ucl .ucl-fleet__scroll::-webkit-scrollbar-thumb{background:var(--vb-gold);border-radius:4px;}\n.vb-ucl .ucl-fleet-card{flex:0 0 340px;min-height:440px;scroll-snap-align:start;border-radius:var(--radius-lg);overflow:hidden;background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);position:relative;transition:all .5s var(--ease);display:flex;flex-direction:column;}\n.vb-ucl .ucl-fleet-card:hover{transform:translateY(-8px);border-color:var(--vb-gold);box-shadow:0 24px 60px rgba(0,0,0,.5);}\n.vb-ucl .ucl-fleet-card__img{position:relative;aspect-ratio:4\/3;overflow:hidden;background:#0a1a3a;}\n.vb-ucl .ucl-fleet-card__img img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease);}\n.vb-ucl .ucl-fleet-card:hover .ucl-fleet-card__img img{transform:scale(1.08);}\n.vb-ucl .ucl-fleet-card__tag{position:absolute;top:14px;left:14px;background:rgba(10,31,68,.85);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:var(--vb-gold-bright);font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:6px 12px;border-radius:999px;font-weight:700;border:1px solid rgba(200,181,96,.4);}\n.vb-ucl .ucl-fleet-card__body{padding:22px 24px 26px;flex:1;display:flex;flex-direction:column;}\n.vb-ucl .ucl-fleet-card__body h3{font-family:var(--font-display);font-weight:700;color:#fff;font-size:22px;margin:0 0 6px;}\n.vb-ucl .ucl-fleet-card__body .cap{color:var(--vb-gold-bright);font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;margin-bottom:14px;display:block;}\n.vb-ucl .ucl-fleet-card__body p{color:rgba(244,239,230,.75);font-size:14px;margin:0 0 18px;line-height:1.55;flex:1;}\n.vb-ucl .ucl-fleet-card__body .mini-cta{color:var(--vb-gold-bright);font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:gap .3s;}\n.vb-ucl .ucl-fleet-card__body .mini-cta:hover{gap:14px;}\n\n\/* WHY *\/\n.vb-ucl .ucl-why{padding:110px 24px;background:linear-gradient(180deg, #04081c 0%, #050f24 100%);}\n.vb-ucl .ucl-why__wrap{max-width:1150px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}\n.vb-ucl .ucl-why h2{font-family:var(--font-display);font-size:clamp(32px,4vw,48px);color:#fff;font-weight:800;margin:0 0 22px;line-height:1.1;}\n.vb-ucl .ucl-why p{color:rgba(244,239,230,.82);font-size:16px;line-height:1.7;margin:0 0 18px;}\n.vb-ucl .ucl-why ul{list-style:none;padding:0;margin:24px 0 0;}\n.vb-ucl .ucl-why li{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px;color:rgba(244,239,230,.88);font-size:15px;line-height:1.55;}\n.vb-ucl .ucl-why li::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--vb-gold);flex-shrink:0;margin-top:9px;box-shadow:0 0 12px rgba(200,181,96,.7);}\n.vb-ucl .ucl-why__img{position:relative;aspect-ratio:4\/5;border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.5);}\n.vb-ucl .ucl-why__img::before{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg, transparent 40%, rgba(4,8,28,.6) 100%);z-index:2;}\n.vb-ucl .ucl-why__img img{width:100%;height:100%;object-fit:cover;}\n.vb-ucl .ucl-why__frame{position:absolute;inset:-12px;border:1px solid var(--vb-gold);border-radius:var(--radius-lg);pointer-events:none;opacity:.5;}\n\n\/* GALLERY + LIGHTBOX *\/\n.vb-ucl .ucl-gal{padding:90px 24px;background:#050f24;}\n.vb-ucl .ucl-gal__grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;}\n.vb-ucl .ucl-gal__item{position:relative;aspect-ratio:1\/1;border-radius:var(--radius-md);overflow:hidden;cursor:pointer;border:1px solid rgba(255,255,255,.08);transition:all .4s var(--ease);}\n.vb-ucl .ucl-gal__item:hover{transform:translateY(-4px);border-color:var(--vb-gold);box-shadow:0 20px 50px rgba(0,0,0,.5);}\n.vb-ucl .ucl-gal__item img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease);}\n.vb-ucl .ucl-gal__item:hover img{transform:scale(1.08);}\n.vb-ucl .ucl-gal__item::after{content:\"+\";position:absolute;bottom:12px;right:14px;width:36px;height:36px;border-radius:50%;background:rgba(10,31,68,.85);color:var(--vb-gold-bright);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;opacity:0;transition:opacity .3s;}\n.vb-ucl .ucl-gal__item:hover::after{opacity:1;}\n.vb-ucl .ucl-lightbox{position:fixed;inset:0;z-index:9999;background:rgba(2,4,12,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);display:none;align-items:center;justify-content:center;padding:40px 20px;}\n.vb-ucl .ucl-lightbox.is-open{display:flex;}\n.vb-ucl .ucl-lightbox__img{max-width:92vw;max-height:85vh;border-radius:var(--radius-md);box-shadow:0 40px 100px rgba(0,0,0,.7);object-fit:contain;}\n.vb-ucl .ucl-lightbox__close{position:absolute;top:24px;right:24px;width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.25);cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;}\n.vb-ucl .ucl-lightbox__close:hover{background:rgba(255,255,255,.2);}\n\n\/* FAQ *\/\n.vb-ucl .ucl-faq{padding:110px 24px;background:linear-gradient(180deg, #050f24 0%, #04081c 100%);}\n.vb-ucl .ucl-faq__list{max-width:900px;margin:0 auto;}\n.vb-ucl .ucl-faq__item{border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-md);margin-bottom:14px;background:rgba(255,255,255,.03);overflow:hidden;transition:all .4s var(--ease);}\n.vb-ucl .ucl-faq__item[open]{border-color:var(--vb-gold);background:rgba(200,181,96,.05);}\n.vb-ucl .ucl-faq__q{padding:22px 28px;font-family:var(--font-display);font-weight:700;font-size:18px;color:#fff;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;list-style:none;}\n.vb-ucl .ucl-faq__q::-webkit-details-marker{display:none;}\n.vb-ucl .ucl-faq__q::after{content:\"+\";width:32px;height:32px;border-radius:50%;background:rgba(200,181,96,.15);color:var(--vb-gold-bright);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;flex-shrink:0;transition:transform .4s var(--ease);}\n.vb-ucl .ucl-faq__item[open] .ucl-faq__q::after{content:\"\u2212\";transform:rotate(180deg);}\n.vb-ucl .ucl-faq__a{padding:0 28px 24px;color:rgba(244,239,230,.8);font-size:15px;line-height:1.7;}\n.vb-ucl .ucl-faq__a p{margin:0 0 10px;}\n.vb-ucl .ucl-faq__a p:last-child{margin:0;}\n\n\/* FINAL CTA *\/\n.vb-ucl .ucl-final{position:relative;overflow:hidden;padding:120px 24px;background:radial-gradient(1000px 600px at 50% 50%, rgba(10,26,107,.8), transparent 70%),linear-gradient(135deg, #04081c 0%, #0a1a6b 100%);}\n.vb-ucl .ucl-final::before{content:\"\";position:absolute;inset:0;background-image:radial-gradient(2px 2px at 20% 30%, rgba(207,230,255,.5), transparent),radial-gradient(1px 1px at 70% 60%, rgba(207,230,255,.6), transparent),radial-gradient(1px 1px at 45% 85%, rgba(207,230,255,.4), transparent),radial-gradient(2px 2px at 85% 25%, rgba(207,230,255,.5), transparent);opacity:.8;}\n.vb-ucl .ucl-final__inner{position:relative;z-index:1;max-width:900px;margin:0 auto;text-align:center;}\n.vb-ucl .ucl-final h2{font-family:var(--font-display);font-weight:800;font-size:clamp(36px,5.5vw,62px);color:#fff;line-height:1.05;letter-spacing:-.02em;margin:0 0 24px;}\n.vb-ucl .ucl-final h2 .shine{background:linear-gradient(100deg, var(--vb-gold), #fff5c8 50%, var(--vb-gold-bright));background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:ucl-shine 4s linear infinite;}\n.vb-ucl .ucl-final p{color:rgba(244,239,230,.88);font-size:18px;line-height:1.65;max-width:660px;margin:0 auto 36px;}\n.vb-ucl .ucl-final__sig{margin-top:40px;padding-top:26px;border-top:1px solid rgba(255,255,255,.12);color:rgba(244,239,230,.6);font-size:13px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;}\n\n\/* STICKY *\/\n.vb-ucl .ucl-sticky{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(130%);z-index:1000;display:flex;gap:14px;align-items:center;padding:12px 16px 12px 20px;background:linear-gradient(135deg, rgba(10,31,68,.95), rgba(5,15,36,.95));backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(200,181,96,.4);border-radius:999px;box-shadow:0 20px 60px rgba(0,0,0,.5);transition:transform .6s var(--ease);max-width:calc(100vw - 32px);}\n.vb-ucl .ucl-sticky.is-visible{transform:translateX(-50%) translateY(0);}\n.vb-ucl .ucl-sticky__msg{color:#fff;font-size:14px;font-weight:600;display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.vb-ucl .ucl-sticky__msg strong{color:var(--vb-gold-bright);}\n.vb-ucl .ucl-sticky__dot{width:8px;height:8px;border-radius:50%;background:var(--ucl-cyan);box-shadow:0 0 10px var(--ucl-cyan);flex-shrink:0;animation:ucl-pulse 2s ease-in-out infinite;}\n.vb-ucl .ucl-sticky .ucl-btn{padding:10px 20px;font-size:13px;}\n\n\/* ANIMATIONS *\/\n@keyframes ucl-kenburns{0%{transform:scale(1.08) translate(0,0);}100%{transform:scale(1.15) translate(-1%,1%);}}\n@keyframes ucl-pulse{0%,100%{transform:scale(1);opacity:1;}50%{transform:scale(1.4);opacity:.65;}}\n@keyframes ucl-shine{0%{background-position:200% 0;}100%{background-position:-200% 0;}}\n@keyframes ucl-shine-slide{0%,70%{transform:translateX(-100%);}100%{transform:translateX(100%);}}\n@keyframes ucl-scroll-line{0%{transform:scaleY(0);transform-origin:top;}50%{transform:scaleY(1);transform-origin:top;}51%{transform-origin:bottom;}100%{transform:scaleY(0);transform-origin:bottom;}}\n@keyframes ucl-trophy-glow{0%,100%{box-shadow:0 0 0 6px rgba(200,181,96,.15),0 0 0 14px rgba(200,181,96,.08),0 20px 60px rgba(200,181,96,.45),inset 0 -10px 20px rgba(0,0,0,.3);}50%{box-shadow:0 0 0 10px rgba(200,181,96,.25),0 0 0 22px rgba(200,181,96,.12),0 30px 80px rgba(200,181,96,.6),inset 0 -10px 20px rgba(0,0,0,.3);}}\n@keyframes ucl-ticker{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}\n\n\/* RESPONSIVE *\/\n@media (max-width:900px){\n  .vb-ucl .ucl-bracket__grid{grid-template-columns:1fr;gap:40px;}\n  .vb-ucl .ucl-why__wrap{grid-template-columns:1fr;gap:40px;}\n  .vb-ucl .ucl-why__img{max-width:420px;margin:0 auto;}\n  .vb-ucl .ucl-hero{min-height:auto;padding:80px 0 60px;}\n}\n@media (max-width:600px){\n  .vb-ucl .ucl-countdown{grid-template-columns:repeat(4,1fr);gap:8px;}\n  .vb-ucl .ucl-cd{padding:14px 6px;}\n  .vb-ucl .ucl-meta{grid-template-columns:repeat(2,1fr);}\n  .vb-ucl .ucl-hero__inner{padding:60px 16px;}\n  .vb-ucl .ucl-bracket,.vb-ucl .ucl-teams,.vb-ucl .ucl-stadium,.vb-ucl .ucl-timeline,.vb-ucl .ucl-why,.vb-ucl .ucl-faq,.vb-ucl .ucl-final{padding-left:16px;padding-right:16px;}\n  .vb-ucl .ucl-fleet-card{flex-basis:280px;min-height:400px;}\n  .vb-ucl .ucl-tl::before{left:18px;}\n  .vb-ucl .ucl-tl__dot{left:3px;width:26px;height:26px;font-size:12px;}\n  .vb-ucl .ucl-tl__item{padding-left:60px;}\n  .vb-ucl .ucl-sticky{left:16px;right:16px;transform:translateY(130%);border-radius:16px;flex-wrap:wrap;}\n  .vb-ucl .ucl-sticky.is-visible{transform:translateY(0);}\n  .vb-ucl .ucl-sticky__msg{font-size:13px;white-space:normal;}\n}\n@media (prefers-reduced-motion:reduce){\n  .vb-ucl *,.vb-ucl *::before,.vb-ucl *::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}\n  .vb-ucl .ucl-canvas{display:none;}\n}",
