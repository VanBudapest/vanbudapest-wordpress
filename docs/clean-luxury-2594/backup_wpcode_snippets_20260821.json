            "title": "VB \u2014 Grant unfiltered_html to admins (MCP fix)",
            "code": "\/**\n * VanBudapest \u2014 Fix for MCP wp_update_post stripping <style> and <script>.\n *\n * On non-multisite-network capable installs, WordPress only grants\n * `unfiltered_html` to users who already have that meta capability.\n * The MCP integration user does not, so every wp_update_post call goes\n * through kses and tears out <style>\/<script> blocks, which breaks\n * pages that rely on inline CSS\/JS (e.g. the F1 calculator).\n *\n * This snippet maps the `unfiltered_html` meta capability to\n * `manage_options`, effectively granting it to administrators\n * (standard behavior on single-site WP installs).\n *\n * Scope: administrators only. No privilege escalation beyond admin.\n *\/\nif (!defined('ABSPATH')) { return; }\n\nadd_filter('map_meta_cap', function ($caps, $cap) {\n    if ($cap === 'unfiltered_html') {\n        return ['manage_options'];\n    }\n    return $caps;\n}, 1, 2);\n",
            "code_type": "php",
