            "id": 23336,
            "title": "VanBudapest JS \u2014 UCL Final 2026 (Post 23324)",
            "code": "(function(){\r\n  'use strict';\r\n  var root = document.querySelector('.vb-ucl');\r\n  if(!root) return;\r\n  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\r\n\r\n  \/* ============= 0) INJECT CANVAS IF KSES STRIPPED IT ============= *\/\r\n  (function injectCanvas(){\r\n    if(root.querySelector('#uclStars')) return;\r\n    var hero = root.querySelector('.ucl-hero');\r\n    if(!hero) return;\r\n    var cv = document.createElement('canvas');\r\n    cv.id = 'uclStars';\r\n    cv.className = 'ucl-canvas';\r\n    cv.setAttribute('aria-hidden','true');\r\n    var bg = hero.querySelector('.ucl-hero__bg');\r\n    if(bg && bg.nextSibling) hero.insertBefore(cv, bg.nextSibling);\r\n    else hero.insertBefore(cv, hero.firstChild);\r\n  })();\r\n\r\n  \/* ============= 1) CANVAS STARFIELD ============= *\/\r\n  (function starfield(){\r\n    if(reduced) return;\r\n    var cv = root.querySelector('#uclStars');\r\n    if(!cv) return;\r\n    var ctx = cv.getContext('2d');\r\n    var stars = [];\r\n    var W, H, DPR;\r\n    function size(){\r\n      DPR = Math.min(window.devicePixelRatio||1, 2);\r\n      W = cv.clientWidth; H = cv.clientHeight;\r\n      cv.width = W*DPR; cv.height = H*DPR;\r\n      ctx.setTransform(DPR,0,0,DPR,0,0);\r\n    }\r\n    function init(){\r\n      size();\r\n      stars = [];\r\n      var n = Math.max(60, Math.floor((W*H)\/14000));\r\n      for(var i=0;i<n;i++){\r\n        stars.push({\r\n          x:Math.random()*W, y:Math.random()*H,\r\n          r:Math.random()*1.3+.3,\r\n          vx:(Math.random()-.5)*.08, vy:(Math.random()-.5)*.08,\r\n          a:Math.random()*.6+.3, tw:Math.random()*Math.PI*2\r\n        });\r\n      }\r\n    }\r\n    function tick(t){\r\n      ctx.clearRect(0,0,W,H);\r\n      for(var i=0;i<stars.length;i++){\r\n        for(var j=i+1;j<stars.length;j++){\r\n          var dx = stars[i].x-stars[j].x, dy = stars[i].y-stars[j].y;\r\n          var d2 = dx*dx+dy*dy;\r\n          if(d2 < 9000){\r\n            var op = (1 - d2\/9000) * .18;\r\n            ctx.strokeStyle = 'rgba(207,230,255,'+op+')';\r\n            ctx.lineWidth = .6;\r\n            ctx.beginPath(); ctx.moveTo(stars[i].x,stars[i].y); ctx.lineTo(stars[j].x,stars[j].y); ctx.stroke();\r\n          }\r\n        }\r\n      }\r\n      for(var k=0;k<stars.length;k++){\r\n        var s = stars[k];\r\n        s.tw += .03;\r\n        var tw = Math.sin(s.tw)*.3 + .7;\r\n        ctx.fillStyle = 'rgba(207,230,255,'+(s.a*tw)+')';\r\n        ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill();\r\n        if(k%17===0){\r\n          ctx.fillStyle = 'rgba(232,212,136,'+(s.a*tw*.8)+')';\r\n          ctx.beginPath(); ctx.arc(s.x,s.y,s.r*1.4,0,Math.PI*2); ctx.fill();\r\n        }\r\n        s.x += s.vx; s.y += s.vy;\r\n        if(s.x<0) s.x=W; else if(s.x>W) s.x=0;\r\n        if(s.y<0) s.y=H; else if(s.y>H) s.y=0;\r\n      }\r\n      requestAnimationFrame(tick);\r\n    }\r\n    window.addEventListener('resize', init, {passive:true});\r\n    init(); requestAnimationFrame(tick);\r\n  })();\r\n\r\n  \/* ============= 2) LIVE COUNTDOWN ============= *\/\r\n  (function countdown(){\r\n    var target = new Date('2026-05-30T21:00:00+02:00').getTime();\r\n    var D = root.querySelector('#cdDays'),\r\n        H = root.querySelector('#cdHours'),\r\n        M = root.querySelector('#cdMins'),\r\n        S = root.querySelector('#cdSecs');\r\n    if(!D) return;\r\n    function pad(n){return (n<10?'0':'')+n;}\r\n    function tick(){\r\n      var diff = target - Date.now();\r\n      if(diff <= 0){\r\n        var box = root.querySelector('.ucl-countdown');\r\n        if(box) box.style.display = 'none';\r\n        return;\r\n      }\r\n      var d = Math.floor(diff\/86400000);\r\n      var h = Math.floor(diff\/3600000)%24;\r\n      var m = Math.floor(diff\/60000)%60;\r\n      var s = Math.floor(diff\/1000)%60;\r\n      D.textContent = pad(d); H.textContent = pad(h); M.textContent = pad(m); S.textContent = pad(s);\r\n    }\r\n    tick(); setInterval(tick, 1000);\r\n  })();\r\n\r\n  \/* ============= 3) 3D TILT ============= *\/\r\n  (function tilt(){\r\n    if(reduced) return;\r\n    var cards = root.querySelectorAll('[data-tilt]');\r\n    cards.forEach(function(card){\r\n      var rx=0, ry=0, tx=0, ty=0, raf=null;\r\n      function move(e){\r\n        var r = card.getBoundingClientRect();\r\n        var x = (e.clientX - r.left) \/ r.width;\r\n        var y = (e.clientY - r.top) \/ r.height;\r\n        tx = (x-.5)*100; ty = (y-.5)*100;\r\n        ry = (x-.5)*10; rx = -(y-.5)*10;\r\n        card.style.setProperty('--mx', (x*100)+'%');\r\n        card.style.setProperty('--my', (y*100)+'%');\r\n        if(!raf) raf = requestAnimationFrame(apply);\r\n      }\r\n      function apply(){\r\n        card.style.transform = 'perspective(1000px) rotateX('+rx+'deg) rotateY('+ry+'deg) translateZ(0)';\r\n        raf = null;\r\n      }\r\n      function leave(){\r\n        card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';\r\n      }\r\n      card.addEventListener('mousemove', move);\r\n      card.addEventListener('mouseleave', leave);\r\n    });\r\n  })();\r\n\r\n  \/* ============= 4) TIMELINE + STATS REVEAL ============= *\/\r\n  (function reveal(){\r\n    var items = root.querySelectorAll('.ucl-tl__item');\r\n    if(!('IntersectionObserver' in window)){\r\n      items.forEach(function(el){el.classList.add('is-in');});\r\n    } else {\r\n      var obs = new IntersectionObserver(function(entries){\r\n        entries.forEach(function(en){\r\n          if(en.isIntersecting){\r\n            var delay = Array.prototype.indexOf.call(en.target.parentNode.children, en.target) * 120;\r\n            setTimeout(function(){en.target.classList.add('is-in');}, delay);\r\n            obs.unobserve(en.target);\r\n          }\r\n        });\r\n      }, {threshold:.2, rootMargin:'0px 0px -80px 0px'});\r\n      items.forEach(function(el){obs.observe(el);});\r\n    }\r\n    var counters = root.querySelectorAll('[data-count]');\r\n    function animateCount(el){\r\n      var target = parseInt(el.getAttribute('data-count'),10);\r\n      var start = 0, dur = 1800, t0 = performance.now();\r\n      function step(now){\r\n        var p = Math.min(1, (now-t0)\/dur);\r\n        var eased = 1 - Math.pow(1-p, 3);\r\n        el.textContent = Math.floor(start + (target-start)*eased).toLocaleString('en-US');\r\n        if(p<1) requestAnimationFrame(step); else el.textContent = target.toLocaleString('en-US');\r\n      }\r\n      requestAnimationFrame(step);\r\n    }\r\n    if(!('IntersectionObserver' in window)){\r\n      counters.forEach(animateCount);\r\n    } else {\r\n      var cobs = new IntersectionObserver(function(entries){\r\n        entries.forEach(function(en){\r\n          if(en.isIntersecting){ animateCount(en.target); cobs.unobserve(en.target); }\r\n        });\r\n      }, {threshold:.3});\r\n      counters.forEach(function(el){cobs.observe(el);});\r\n    }\r\n  })();\r\n\r\n  \/* ============= 5) STADIUM PARALLAX ============= *\/\r\n  (function parallax(){\r\n    if(reduced) return;\r\n    var bg = root.querySelector('#uclParallax');\r\n    if(!bg) return;\r\n    var section = bg.parentElement;\r\n    var ticking = false;\r\n    function update(){\r\n      var r = section.getBoundingClientRect();\r\n      var vh = window.innerHeight;\r\n      if(r.bottom < 0 || r.top > vh) {ticking=false; return;}\r\n      var progress = (vh - r.top) \/ (vh + r.height);\r\n      var shift = (progress - .5) * 80;\r\n      bg.style.transform = 'translate3d(0,'+shift.toFixed(1)+'px,0) scale(1.12)';\r\n      ticking = false;\r\n    }\r\n    window.addEventListener('scroll', function(){\r\n      if(!ticking){ requestAnimationFrame(update); ticking = true; }\r\n    }, {passive:true});\r\n    update();\r\n  })();\r\n\r\n  \/* ============= 6) LIGHTBOX ============= *\/\r\n  (function lightbox(){\r\n    var gal = root.querySelector('#uclGallery');\r\n    var lb = root.querySelector('#uclLightbox');\r\n    var lbImg = root.querySelector('#uclLightboxImg');\r\n    var closeBtn = root.querySelector('#uclLightboxClose');\r\n    if(!gal || !lb) return;\r\n    function open(src, alt){\r\n      lbImg.src = src; lbImg.alt = alt || '';\r\n      lb.classList.add('is-open');\r\n      document.body.style.overflow = 'hidden';\r\n    }\r\n    function close(){\r\n      lb.classList.remove('is-open');\r\n      lbImg.src = '';\r\n      document.body.style.overflow = '';\r\n    }\r\n    gal.addEventListener('click', function(e){\r\n      var img = e.target.closest('img');\r\n      if(!img) return;\r\n      var full = img.getAttribute('data-full') || img.src;\r\n      open(full, img.alt);\r\n    });\r\n    if(closeBtn) closeBtn.addEventListener('click', close);\r\n    lb.addEventListener('click', function(e){ if(e.target === lb) close(); });\r\n    document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });\r\n  })();\r\n\r\n  \/* ============= 7) STICKY BAR ============= *\/\r\n  (function sticky(){\r\n    var bar = root.querySelector('#uclSticky');\r\n    if(!bar) return;\r\n    var shown = false;\r\n    function check(){\r\n      var y = window.scrollY || window.pageYOffset;\r\n      var show = y > window.innerHeight * 1.2;\r\n      var docH = document.documentElement.scrollHeight - window.innerHeight;\r\n      if(y > docH - 400) show = false;\r\n      if(show !== shown){\r\n        shown = show;\r\n        bar.classList.toggle('is-visible', show);\r\n        bar.setAttribute('aria-hidden', show ? 'false' : 'true');\r\n      }\r\n    }\r\n    window.addEventListener('scroll', check, {passive:true});\r\n    window.addEventListener('resize', check, {passive:true});\r\n    check();\r\n  })();\r\n\r\n})();",
