 setTimeout(function(){\r\n              scroll_.scrollTo({top: Math.max(0, item.offsetTop - 4), behavior: prefersReduce() ? 'auto' : 'smooth'});\r\n              setTimeout(updateFade, 340);\r\n            }, 70);\r\n          }\r\n          updateFade();\r\n        }\r\n        lbtn.addEventListener('click', toggle);\r\n\r\n        item.appendChild(row); item.appendChild(panel);\r\n      } else {\r\n        var link = el('a','vbm-link');\r\n        link.href = n.href;\r\n        var lt = el('span','vbm-lbltxt'); lt.textContent = n.label;\r\n        link.appendChild(lt);\r\n        if(samePage(n.href)){ row.classList.add('vbm-cur'); link.setAttribute('aria-current','page'); }\r\n        row.appendChild(link);\r\n        item.appendChild(row);\r\n      }\r\n      scroll_.appendChild(item);\r\n    });\r\n\r\n    fade = el('div','vbm-fade');\r\n    fade.setAttribute('aria-hidden','true');\r\n    wrap.appendChild(scroll_); wrap.appendChild(fade);\r\n    drawer.appendChild(wrap);\r\n\r\n    var cta = el('div','vbm-cta');\r\n    var main = el('a','vbm-cta-main',\r\n      '<span class=\"vbm-cta-l\">Fast Booking Form<\/span>'+\r\n      '<span class=\"vbm-cta-s\">'+SVG_BOLT+'12H reply<\/span>');\r\n    main.href = FORM_URL;\r\n    var alts = el('div','vbm-alts');\r\n    var t = el('a','vbm-alt',SVG_TEL+'Call us'); t.href=TEL;\r\n    var w = el('a','vbm-alt',SVG_WA+'WhatsApp'); w.href=WA; w.target='_blank'; w.rel='noopener';\r\n    alts.appendChild(t); alts.appendChild(w);\r\n    cta.appendChild(main); cta.appendChild(alts);\r\n    drawer.appendChild(cta);\r\n\r\n    document.body.appendChild(backdrop);\r\n    document.body.appendChild(drawer);\r\n\r\n    backdrop.addEventListener('click', close);\r\n    xbtn.addEventListener('click', close);\r\n    \/* linkkattint\u00e1sra z\u00e1runk (same-tab navig\u00e1ci\u00f3 el\u0151tt) \u2014 tel: \u00e9s _blank kiv\u00e9tel *\/\r\n    drawer.addEventListener('click', function(e){\r\n      var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;\r\n      if(a && !a.target && (a.getAttribute('href')||'').charAt(0)!=='#' && (a.protocol||'')!=='tel:') close();\r\n    });\r\n    scroll_.addEventListener('scroll', updateFade, {passive:true});\r\n    document.addEventListener('keydown', onKey);\r\n\r\n    function onViewport(){\r\n      if(!isMobile() && document.body.classList.contains('vbm-open')) close();\r\n      \/* orient\u00e1ci\u00f3v\u00e1lt\u00e1s: a nyitott panel be\u00e9getett max-height-j\u00e1nak friss\u00edt\u00e9se *\/\r\n      if(scroll_){\r\n        qa('.vbm-row.vbm-on', scroll_).forEach(function(r){\r\n          var p = r.parentElement && q('.vbm-panel', r.parentElement);\r\n          if(p) p.style.maxHeight = p.scrollHeight + 'px';\r\n        });\r\n      }\r\n      updateFade();\r\n    }\r\n    window.addEventListener('resize', onViewport);\r\n    try{\r\n      var mq = window.matchMedia('(min-width:'+BP+'px)');\r\n      if(mq.addEventListener) mq.addEventListener('change', onViewport);\r\n      else if(mq.addListener) mq.addListener(onViewport);\r\n    }catch(e){}\r\n\r\n    return true;\r\n  }\r\n\r\n  function updateFade(){\r\n    if(!fade || !scroll_) return;\r\n    fade.classList.toggle('vbm-on', scroll_.scrollHeight - scroll_.clientHeight - scroll_.scrollTop > 6);\r\n  }\r\n\r\n  function open(){\r\n    if(!isMobile()) return;\r\n    if(document.body.classList.contains('vbm-open')) return;\r\n    if(!build()) return;\r\n    setVH();                      \/* v3.3 \u2014 nyit\u00e1s pillanat\u00e1ban m\u00e9r\u00fcnk *\/\r\n    lastFocus = document.activeElement;\r\n    document.body.style.top = '-' + window.pageYOffset + 'px';\r\n    document.body.dataset.vbmY = window.pageYOffset;\r\n    document.body.classList.add('vbm-open');\r\n    try{ drawer.inert = false; }catch(e){}\r\n    drawer.removeAttribute('aria-hidden');\r\n    setBgInert(true);\r\n    if(openBtn) openBtn.setAttribute('aria-expanded','true');\r\n    setTimeout(function(){ if(xbtn) xbtn.focus(); updateFade(); }, 90);\r\n  }\r\n\r\n  function close(){\r\n    var y = parseInt(document.body.dataset.vbmY || '0', 10);\r\n    document.body.classList.remove('vbm-open');\r\n    document.body.style.top = '';\r\n    window.scrollTo(0, y);\r\n    if(drawer){\r\n      drawer.setAttribute('aria-hidden','true');\r\n      \/* a kics\u00fasz\u00e1s (.34s) v\u00e9g\u00e9n tessz\u00fck inertt\u00e9, hogy az anim\u00e1ci\u00f3 l\u00e1tsz\u00f3djon *\/\r\n      setTimeout(function(){\r\n        if(!document.body.classList.contains('vbm-open')){ try{ drawer.inert = true; }catch(e){} }\r\n      }, 360);\r\n    }\r\n    setBgInert(false);\r\n    if(openBtn) openBtn.setAttribute('aria-expanded','false');\r\n    if(lastFocus && lastFocus.focus){ try{ lastFocus.focus(); }catch(e){} }\r\n  }\r\n\r\n  function onKey(e){\r\n    if(!document.body.classList.contains('vbm-open')) return;\r\n    if(e.key==='Escape'){ close(); return; }\r\n    if(e.key!=='Tab') return;\r\n    var f = qa('a[href],button:not([disabled])', drawer).filter(function(x){\r\n      return x.getClientRects().length>0 && getComputedStyle(x).visibility!=='hidden';\r\n    });\r\n    if(!f.length) return;\r\n    var first=f[0], last=f[f.length-1];\r\n    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }\r\n    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }\r\n  }\r\n\r\n  \/* bfcache-visszal\u00e9p\u00e9s: ne \u00e1lljon vissza a befagyasztott nyitott fi\u00f3k *\/\r\n  window.addEventListener('pageshow', function(e){\r\n    if(e.persisted && document.body.classList.contains('vbm-open')) close();\r\n  });\r\n\r\n  \/* \u2500\u2500 ind\u00edt\u00e1s: a core hamburger \u00e1tv\u00e9tele \u2014 CSAK sikeres parse ut\u00e1n \u2500\u2500\u2500\u2500\u2500\u2500 *\/\r\n  function init(){\r\n    var b = q('.wp-block-navigation__responsive-container-open');\r\n    \/* identit\u00e1s-\u0151r: ha a gomb ugyanaz az elem, amit m\u00e1r mi k\u00f6t\u00f6tt\u00fcnk, k\u00e9sz;\r\n       ha b\u00e1rki (pl. egy m\u00e1sik snippet) kicser\u00e9lte, \u00fajrak\u00f6t\u00fcnk *\/\r\n    if(!b || b === openBtn) return;\r\n    if(!parseTree()) return;                     \/* parse-hiba \u2192 a core men\u00fc marad *\/\r\n    document.body.classList.add('vbm-ready');    \/* mostant\u00f3l rejthet\u0151 a core overlay *\/\r\n\r\n    var nb = b.cloneNode(true);\r\n    \/* a core Interactivity API direkt\u00edv\u00e1inak t\u00f6rl\u00e9se a kl\u00f3nr\u00f3l \u2014\r\n       a hidrat\u00e1l\u00e1s k\u00fcl\u00f6nben visszak\u00f6tn\u00e9 az actions.openMenuOnClick-et *\/\r\n    Array.prototype.slice.call(nb.attributes).forEach(function(a){\r\n      if(a.name.indexOf('data-wp-')===0) nb.removeAttribute(a.name);\r\n    });\r\n    b.parentNode.replaceChild(nb, b);\r\n    openBtn = nb;\r\n    openBtn.setAttribute('aria-expanded','false');\r\n    openBtn.setAttribute('aria-label','Open menu');\r\n    openBtn.addEventListener('click', function(e){\r\n      if(!isMobile()) return;\r\n      e.preventDefault(); e.stopImmediatePropagation();\r\n      open();\r\n    });\r\n  }\r\n\r\n  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);\r\n  else init();\r\n  window.addEventListener('load', function(){ setTimeout(init, 60); });\r\n})();\r\n<\/script>\r\n",
