            "title": "VB Wedding (18881) \u2014 FAQ + Service Schema",
            "code": "\r\n\/* VanBudapest \u2014 Wedding page (18881) structured data: FAQPage + Service. Scoped to page 18881 only; does not touch post_content. *\/\r\nadd_action( 'wp_head', function () {\r\n\tif ( ! ( function_exists( 'is_page' ) && is_page( 18881 ) ) ) { return; }\r\n\techo <<<'VBLD'\r\n<script type=\"application\/ld+json\">{\"@context\":\"https:\/\/schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How far in advance should we book wedding transportation in Budapest?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As early as possible\u2014especially for peak wedding months, large guest lists, or multi-vehicle needs. Early booking helps secure the right vehicle mix and timeline.\"}},{\"@type\":\"Question\",\"name\":\"Do you provide transportation for wedding guests, not just the couple?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Guest shuttles are one of the most valuable services we provide\u2014hotel blocks to venues, venue-to-venue, and late-night returns.\"}},{\"@type\":\"Question\",\"name\":\"Can you handle airport transfers for wedding guests arriving from abroad?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We can plan arrivals and departures around real flight timing, luggage needs, and hotel check-ins.\"}},{\"@type\":\"Question\",\"name\":\"Can we book multiple vehicles for different groups?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolutely. Many weddings use separate vehicles for the couple, VIP family members, and guest shuttles.\"}},{\"@type\":\"Question\",\"name\":\"Is this a limo\/party bus service?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We're a professional chauffeur service focused on elegant, reliable wedding logistics. If you want a party-focused vehicle experience, tell us your vision and we'll advise on the best fit.\"}},{\"@type\":\"Question\",\"name\":\"Can you support multi-day destination weddings?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We can build a multi-day transportation plan for welcome events, ceremony day logistics, reception, after-party rides, and departure day transfers.\"}},{\"@type\":\"Question\",\"name\":\"Do you offer hourly bookings for wedding-day flexibility?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Hourly service is often the simplest way to cover photo stops, schedule shifts, and multi-stop routing.\"}},{\"@type\":\"Question\",\"name\":\"Where can I see your terms and policies?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You can review them here: Terms & Conditions and Privacy Policy at https:\/\/vanbudapest.com\/terms-and-conditions-and-privacy-policy\/\"}}]}<\/script>\r\n<script type=\"application\/ld+json\">{\"@context\":\"https:\/\/schema.org\",\"@type\":\"Service\",\"serviceType\":\"Wedding Transportation & Chauffeur Service\",\"name\":\"Premium Wedding Transportation in Budapest\",\"url\":\"https:\/\/vanbudapest.com\/wedding-transportation-budapest\/\",\"areaServed\":[{\"@type\":\"City\",\"name\":\"Budapest\"},{\"@type\":\"Country\",\"name\":\"Hungary\"}],\"provider\":{\"@type\":\"Organization\",\"name\":\"VanBudapest.com\",\"url\":\"https:\/\/vanbudapest.com\/\",\"logo\":\"https:\/\/vanbudapest.com\/wp-content\/uploads\/2026\/02\/VB-LOGO.png\",\"telephone\":\"+36 70 753 6333\",\"email\":\"info@vanbudapest.com\"}}<\/script>\r\nVBLD;\r\n\techo \"\\n\";\r\n}, 20 );\r\n",
