            "title": "Disable Jetpack SEO Tools module (duplicate meta description fix)",
            "code": "\/\/ CONT-01\/TECH-001 fix (2026-06-10): Jetpack 'seo-tools' modul kiszurese.\r\n\/\/ A Jetpack seo-tools generalta a masodik, csonka meta description-t a fooldalon.\r\n\/\/ A description-t tovabbra is a sajat vb-seo-manager plugin adja.\r\n\/\/ Reverzibilis: a snippet kikapcsolasaval a modul visszaall, DB-t nem modosit.\r\nadd_filter( 'option_jetpack_active_modules', function ( $modules ) {\r\n\tif ( is_array( $modules ) ) {\r\n\t\t$modules = array_values( array_diff( $modules, array( 'seo-tools' ) ) );\r\n\t}\r\n\treturn $modules;\r\n}, 20 );",
