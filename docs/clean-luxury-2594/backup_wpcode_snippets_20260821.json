            "title": "VanBudapest Cookie Consent Banner + Consent Mode Update",
            "code": "<!-- VanBudapest GDPR Cookie Consent Banner v1.1 (T&C link fix) -->\n<!-- Consent Mode v2 compatible \u2014 updates gtag consent on user action -->\n<style>\n#vb-consent-banner {\n  display: none;\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  z-index: 999999;\n  background: #0A1F44;\n  border-top: 2px solid #C8B560;\n  padding: 18px 24px;\n  font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n  box-shadow: 0 -4px 20px rgba(0,0,0,0.3);\n  animation: vbSlideUp 0.4s ease-out;\n}\n@keyframes vbSlideUp {\n  from { transform: translateY(100%); opacity: 0; }\n  to { transform: translateY(0); opacity: 1; }\n}\n#vb-consent-banner .vb-consent-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n#vb-consent-banner .vb-consent-text {\n  color: #FFFFFF;\n  font-size: 14px;\n  line-height: 1.5;\n  flex: 1;\n  min-width: 280px;\n}\n#vb-consent-banner .vb-consent-text a {\n  color: #C8B560;\n  text-decoration: underline;\n}\n#vb-consent-banner .vb-consent-buttons {\n  display: flex;\n  gap: 10px;\n  flex-shrink: 0;\n}\n#vb-consent-banner .vb-btn-accept {\n  background: #C8B560;\n  color: #0A1F44;\n  border: none;\n  padding: 10px 24px;\n  font-size: 14px;\n  font-weight: 700;\n  border-radius: 4px;\n  cursor: pointer;\n  letter-spacing: 0.3px;\n  transition: background 0.2s;\n}\n#vb-consent-banner .vb-btn-accept:hover {\n  background: #B78D38;\n}\n#vb-consent-banner .vb-btn-decline {\n  background: transparent;\n  color: #FFFFFF;\n  border: 1px solid rgba(255,255,255,0.3);\n  padding: 10px 18px;\n  font-size: 14px;\n  font-weight: 400;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: border-color 0.2s;\n}\n#vb-consent-banner .vb-btn-decline:hover {\n  border-color: rgba(255,255,255,0.6);\n}\n@media (max-width: 600px) {\n  #vb-consent-banner { padding: 14px 16px; }\n  #vb-consent-banner .vb-consent-inner { flex-direction: column; gap: 12px; }\n  #vb-consent-banner .vb-consent-buttons { width: 100%; }\n  #vb-consent-banner .vb-btn-accept,\n  #vb-consent-banner .vb-btn-decline { flex: 1; text-align: center; }\n}\n<\/style>\n\n<div id=\"vb-consent-banner\" role=\"dialog\" aria-label=\"Cookie consent\">\n  <div class=\"vb-consent-inner\">\n    <div class=\"vb-consent-text\">\n      We use cookies to improve your experience, analyse site traffic, and personalise advertising.\n      By clicking <strong>\"Accept\"<\/strong>, you consent to analytics and advertising cookies.\n      <a href=\"\/terms-and-conditions-and-privacy-policy\/\" target=\"_blank\" rel=\"noopener\">Privacy Policy<\/a>\n    <\/div>\n    <div class=\"vb-consent-buttons\">\n      <button class=\"vb-btn-accept\" id=\"vb-consent-accept\">Accept<\/button>\n      <button class=\"vb-btn-decline\" id=\"vb-consent-decline\">Decline<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n(function(){\n  'use strict';\n  var COOKIE_NAME = 'vb_consent';\n  var COOKIE_DAYS = 365;\n\n  function getCookie(name) {\n    var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));\n    return m ? m[2] : null;\n  }\n  function setCookie(name, value, days) {\n    var d = new Date();\n    d.setTime(d.getTime() + days * 86400000);\n    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=\/;SameSite=Lax;Secure';\n  }\n\n  function updateConsent(granted) {\n    if (typeof gtag !== 'function') return;\n    if (granted) {\n      gtag('consent', 'update', {\n        'ad_storage': 'granted',\n        'ad_user_data': 'granted',\n        'ad_personalization': 'granted',\n        'analytics_storage': 'granted',\n        'functionality_storage': 'granted',\n        'personalization_storage': 'granted'\n      });\n      console.log('[VB-Consent] Consent GRANTED \u2014 all storage types updated');\n    } else {\n      \/* Consent stays at default (denied) \u2014 no update needed *\/\n      console.log('[VB-Consent] Consent DECLINED \u2014 defaults remain');\n    }\n  }\n\n  function hideBanner() {\n    var el = document.getElementById('vb-consent-banner');\n    if (el) el.style.display = 'none';\n  }\n\n  function showBanner() {\n    var el = document.getElementById('vb-consent-banner');\n    if (el) el.style.display = 'block';\n  }\n\n  \/* Check if user already made a choice *\/\n  var existing = getCookie(COOKIE_NAME);\n  if (existing === 'granted') {\n    \/* Re-apply granted consent on return visits *\/\n    updateConsent(true);\n    return;\n  }\n  if (existing === 'denied') {\n    \/* Already declined, don't show banner again *\/\n    return;\n  }\n\n  \/* No choice yet \u2014 show banner after short delay *\/\n  function init() {\n    setTimeout(showBanner, 800);\n\n    document.getElementById('vb-consent-accept').addEventListener('click', function() {\n      setCookie(COOKIE_NAME, 'granted', COOKIE_DAYS);\n      updateConsent(true);\n      hideBanner();\n    });\n\n    document.getElementById('vb-consent-decline').addEventListener('click', function() {\n      setCookie(COOKIE_NAME, 'denied', COOKIE_DAYS);\n      updateConsent(false);\n      hideBanner();\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n<\/script>",
