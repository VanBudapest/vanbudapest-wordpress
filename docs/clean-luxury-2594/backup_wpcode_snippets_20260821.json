            "title": "Disable Jetpack Duplicate OG and Canonical Tags",
            "code": "\/\/ Disable Jetpack Open Graph meta tags (prevents duplicate og:title, og:description)\r\nadd_filter( 'jetpack_enable_open_graph', '__return_false' );\r\n\r\n\/\/ Disable Jetpack canonical URL output (prevents duplicate canonical)\r\nadd_action( 'init', function() {\r\n    if ( class_exists( 'Jetpack' ) ) {\r\n        add_filter( 'jetpack_disable_seo_tools', '__return_true' );\r\n    }\r\n} );\r\n\r\n\/\/ Remove Jetpack's canonical output if VB SEO Manager handles it\r\nadd_action( 'wp_loaded', function() {\r\n    remove_action( 'wp_head', 'rel_canonical' );\r\n} );\r\n\r\n\/\/ 301 Redirect: old \/transfer-online-booking\/ to new \/airport-transfer-budapest\/\r\nadd_action( 'template_redirect', function() {\r\n    if ( isset( $_SERVER['REQUEST_URI'] ) && preg_match( '#^\/transfer-online-booking\/?$#', $_SERVER['REQUEST_URI'] ) ) {\r\n        wp_redirect( home_url( '\/airport-transfer-budapest\/' ), 301 );\r\n        exit;\r\n    }\r\n} );",
