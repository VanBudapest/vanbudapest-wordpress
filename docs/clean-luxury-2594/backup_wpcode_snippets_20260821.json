        {
            "id": 23312,
            "title": "Google Ads Conversion Event \u2014 Booking Form Submit",
            "code": "\/**\r\n * Google Ads Conversion Tracking \u2014 VanBudapest Booking Form Submit\r\n * Fires AW-634016224\/HwllCN6V9pscEOCjqa4C on successful form submission.\r\n * \r\n * Works on ALL pages with the vb-booking-template plugin form.\r\n * \r\n * Triggers (in order of reliability):\r\n * 1. vbConfirmOverlay appears in DOM (MutationObserver on body)\r\n *    \u2014 This is the \"Thank You\" modal created by showConfirmationModal()\r\n * 2. confirmSendBtn click + 3s delay check for vbConfirmOverlay\r\n *    \u2014 Backup: fires after CONFIRM & SEND is clicked and confirmation appears\r\n * \r\n * Element IDs (from booking-form-main.js v12):\r\n *   #submitBtn       = \"Request a Quote\" button (opens review modal, NOT submit)\r\n *   #confirmSendBtn  = \"Confirm & Send\" button (actual AJAX submit)\r\n *   #vbConfirmOverlay = Thank You confirmation overlay (created after success)\r\n *   #vbConfirmCard    = Thank You card inside overlay\r\n *\/\r\n(function() {\r\n  'use strict';\r\n  var convSent = false;\r\n\r\n  function fireConversion() {\r\n    if (convSent) return;\r\n    if (typeof gtag !== 'function') {\r\n      console.warn('[VB-GAds] gtag not available \u2014 skipping conversion');\r\n      return;\r\n    }\r\n    gtag('event', 'conversion', {\r\n      'send_to': 'AW-634016224\/HwllCN6V9pscEOCjqa4C',\r\n      'value': 1.0,\r\n      'currency': 'EUR'\r\n    });\r\n    convSent = true;\r\n    console.log('[VB-GAds] Conversion fired: Booking Form Submit');\r\n  }\r\n\r\n  \/* Trigger 1 (primary): Watch for vbConfirmOverlay appearing in DOM *\/\r\n  function watchConfirmOverlay() {\r\n    var observer = new MutationObserver(function(mutations) {\r\n      for (var i = 0; i < mutations.length; i++) {\r\n        var added = mutations[i].addedNodes;\r\n        for (var j = 0; j < added.length; j++) {\r\n          var node = added[j];\r\n          if (node.nodeType === 1) {\r\n            if (node.id === 'vbConfirmOverlay' || \r\n                (node.querySelector && node.querySelector('#vbConfirmOverlay'))) {\r\n              fireConversion();\r\n              observer.disconnect();\r\n              return;\r\n            }\r\n          }\r\n        }\r\n      }\r\n    });\r\n    observer.observe(document.body, { childList: true, subtree: true });\r\n  }\r\n\r\n  \/* Trigger 2 (backup): confirmSendBtn click + delay check *\/\r\n  function watchConfirmBtn() {\r\n    var btn = document.getElementById('confirmSendBtn');\r\n    if (!btn) return;\r\n    btn.addEventListener('click', function() {\r\n      setTimeout(function() {\r\n        if (document.getElementById('vbConfirmOverlay')) {\r\n          fireConversion();\r\n        }\r\n      }, 3000);\r\n    });\r\n  }\r\n\r\n  \/* Init *\/\r\n  function init() {\r\n    watchConfirmOverlay();\r\n    watchConfirmBtn();\r\n  }\r\n\r\n  if (document.readyState === 'loading') {\r\n    document.addEventListener('DOMContentLoaded', init);\r\n  } else {\r\n    init();\r\n  }\r\n  \/* Backup: reinit btn watcher after 2s for async-loaded forms *\/\r\n  setTimeout(function() { watchConfirmBtn(); }, 2000);\r\n})();",
