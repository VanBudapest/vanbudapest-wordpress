ent.toLowerCase();\n      const c = card.getAttribute('data-country');\n      const d = card.getAttribute('data-date'); \/\/ yyyy-mm-dd\n      const okTerm = !term || text.includes(term);\n      const okCountry = !ctry || c === ctry;\n      const okYear = !yr || (d && d.startsWith(yr));\n      const show = okTerm && okCountry && okYear;\n      card.style.display = show ? '' : 'none';\n      if(show) visible++;\n    });\n    count.textContent = visible + ' shown';\n  }\n  q.addEventListener('input', refresh);\n  country.addEventListener('change', refresh);\n  year.addEventListener('change', refresh);\n  refresh();\n<\/script>\n<\/body>\n<\/html>\n\n\n\n<p class=\"wp-block-paragraph\">You have just read the most relevant results for you. You can also view our archive of reviews on this page: <a href=\"http:\/\/vanbudapest\" target=\"_blank\" rel=\"noreferrer noopener\">Archive &gt;<\/a>. Find more of our references here: <a href=\"https:\/\/vanbudapest.com\/client-references\/\" target=\"_blank\" rel=\"noreferrer noopener\">Client References<\/a><\/p>\n\n\n\n<div style=\"height:27px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"wp-block-jetpack-tiled-gallery alignfull is-style-rectangular\"><div class=\"\"><div class=\"tiled-gallery__gallery\"><div class=\"tiled-gallery__row\"><div class=\"tiled-gallery__col\" style=\"flex-basis:69.64941%\"><figure class=\"tiled-gallery__item\"><img decoding=\"async\" role=\"button\" tabindex=\"0\" aria-label=\"Open image 1 of 3 in full-screen\" srcset=\"https:\/\/i0.wp.com\/vanbudapest.com\/wp-content\/uploads\/2024\/05\/chengshi_guanguang_budapest-1.jpg;w=750?strip=info&#038;w=600&#038;ssl=1 600w,https:\/\/i0.wp.com\/vanbudapest.com\/wp-content\/uploads\/2024\/05\/chengshi_guanguang_budapest-1.jpg;w=750?strip=info&#038;w=900&#038;ssl=1 900w,https:\/\/i0.wp.com\/vanbudapest.com\/wp-content\/uploads\/2024\/05\/chengshi_guanguang_budapest-1.jpg;w=750?strip=info&#038;w=1200&#038;ssl=1 1200w,https:\/\/i0.wp